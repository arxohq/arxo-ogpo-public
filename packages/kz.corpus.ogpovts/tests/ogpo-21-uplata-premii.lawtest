        assert "u21-c-a10": raschet_bonus_malus_dogovora(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:bm:ogpo:c1-c")) { origin case_input; }
        assert "u21-c-a10-bm1": kz.corpus.bonus_malus::osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:ogpo:c1-c"), kz.corpus.bonus_malus::OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
