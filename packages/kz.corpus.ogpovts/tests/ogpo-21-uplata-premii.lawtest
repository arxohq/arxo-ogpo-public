// Рассрочка отводит умолчание пункта 1: обязанности разового платежа не
// возникает вовсе, а возникает обязанность уплатить очередной взнос.
test "urn:query:ogpo-21-rassrochka" {
    given {
        context {
            decision_time @2026-09-05T12:00:00+05:00;
            knowledge_time @2026-09-05T12:00:00+05:00;
            legal_time @2026-09-05;
            timezone "Asia/Almaty";
        }
        assert "u21-d-a0": policyholder_of(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:insurer:i1")) { origin case_input; }
        assert "u21-d-a1": contract_concluded(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
        assert "u21-d-a2": contract_concluded_on(entity_ref("urn:kz:ogpo:contract:c1"), @2026-09-01) { origin case_input; }
        assert "u21-d-a3": contract_premium_due_day(entity_ref("urn:kz:ogpo:contract:c1"), @2026-09-10) { origin case_input; }
        assert "u21-d-a4": applicable_mrp(4325 KZT) { origin case_input; }
        assert "u21-d-a5": territory_basis(entity_ref("urn:kz:ogpo:contract:c1"), TemporaryEntry) { origin case_input; }
        assert "u21-d-a6": vehicle_type_of(entity_ref("urn:kz:ogpo:contract:c1"), MotorVehicle) { origin case_input; }
        assert "u21-d-a7": insured_kind_of(entity_ref("urn:kz:ogpo:contract:c1"), LegalEntity) { origin case_input; }
        assert "u21-d-a8": vehicle_operation_term_years(entity_ref("urn:kz:ogpo:contract:c1"), 5) { origin case_input; }
        assert "u21-d-a9": "urn:kz:corpus:clir:ogpo-vts:table:operation-term-coefficient/input"(5) { origin case_input; }
        assert "u21-d-a10": raschet_bonus_malus_dogovora(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:bm:ogpo:c1-d")) { origin case_input; }
        assert "u21-d-a10-bm1": kz.corpus.bonus_malus::osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:ogpo:c1-d"), kz.corpus.bonus_malus::OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
        assert "u21-d-a10-bm2": kz.corpus.bonus_malus::deystvuyushchiy_klass(entity_ref("urn:kz:bm:ogpo:c1-d"), kz.corpus.bonus_malus::Klass3) { origin case_input; }
        assert "u21-d-a10-bm3": kz.corpus.bonus_malus::dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:ogpo:c1-d"), 269) { origin case_input; }
        assert "u21-d-a11": instalment_payment_stipulated(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
        assert "u21-d-a12": instalment_schedule(entity_ref("urn:kz:ogpo:contract:c1"), 1, 21694.2 KZT, @2026-09-10) { origin case_input; }
    }
    evaluate positions();
    expect not position(UplatitStrakhovuyuPremiyu, ACTIVE);
    expect position(UplatitOcherednoyStrakhovoyVznos, ACTIVE);
}

// Способ уплаты при рассрочке — `Instalments`, и он ЕДИНСТВЕННЫЙ:
// `key(contract)` у вывода поймал бы второй ответ конфликтом ключа.
test "urn:query:ogpo-21-1-sposob-rassrochka" {
    given {
        context {
            decision_time @2026-09-05T12:00:00+05:00;
            knowledge_time @2026-09-05T12:00:00+05:00;
            legal_time @2026-09-05;
            timezone "Asia/Almaty";
        }
        assert "u21-e-a0": contract_concluded(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
        assert "u21-e-a1": instalment_payment_stipulated(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
    }
    evaluate truth(applicable_premium_payment_mode(entity_ref("urn:kz:ogpo:contract:c1"), Instalments));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Договором иное не предусмотрено — умолчание пункта 1: разовый платёж.
test "urn:query:ogpo-21-1-sposob-razovyy" {
    given {
        context {
            decision_time @2026-09-05T12:00:00+05:00;
            knowledge_time @2026-09-05T12:00:00+05:00;
            legal_time @2026-09-05;
            timezone "Asia/Almaty";
        }
        assert "u21-f-a0": contract_concluded(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
    }
    evaluate truth(applicable_premium_payment_mode(entity_ref("urn:kz:ogpo:contract:c1"), SinglePayment));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Пункт 2 предложение третье и пункт 3: неуплата очередного взноса даёт
// страхователю ИММУНИТЕТ от досрочного прекращения договора и вместе с тем
// обязанность уплатить неустойку по статье 353 ГК РК.
test "urn:query:ogpo-21-2-3-immunitet-i-neustoyka" {
    given {
        context {
            decision_time @2026-09-20T12:00:00+05:00;
            knowledge_time @2026-09-20T12:00:00+05:00;
            legal_time @2026-09-20;
            timezone "Asia/Almaty";
        }
        assert "u21-g-a0": policyholder_of(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:insurer:i1")) { origin case_input; }
        assert "u21-g-a1": contract_concluded(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
        assert "u21-g-a2": instalment_payment_stipulated(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
        assert "u21-g-a3": instalment_overdue(entity_ref("urn:kz:ogpo:contract:c1"), 1) { origin case_input; }
    }
    evaluate positions();
    expect position(NeuplataVznosaNeVlechetPrekrashcheniya, ACTIVE);
    expect position(UplatitNeustoykuZaProsrochkuVznosa, ACTIVE);
}

// Пункт 2 предложение второе: при рассрочке ответственность страховщика
// покрывает весь срок действия договора.
test "urn:query:ogpo-21-2-otvetstvennost-ves-srok" {
    given {
        context {
            decision_time @2026-09-20T12:00:00+05:00;
            knowledge_time @2026-09-20T12:00:00+05:00;
            legal_time @2026-09-20;
            timezone "Asia/Almaty";
        }
        assert "u21-h-a0": instalment_payment_stipulated(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
    }
    evaluate truth(insurer_liable_for_whole_contract_term(entity_ref("urn:kz:ogpo:contract:c1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
