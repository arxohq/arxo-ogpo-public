language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 16 п. 2 пп. 2) и ст. 21: обязанность уплатить страховую премию в
// размере статей 19—20 и в срок, установленный договором.
//
// РАЗМЕР СЧИТАЕТСЯ ВРУЧНУЮ И СВЕРЯЕТСЯ:
//   базовая страховая премия  = 1,9 МРП = 1,9 × 4325 = 8217,5 тенге;
//   территориальный коэффициент (временный въезд, п. 5)      = 4,4;
//   тип транспортного средства (мототранспорт, п. 6)         = 1,00;
//   страхователь — юридическое лицо (п. 8)                   = 1,2;
//   срок эксплуатации 5 лет, до 7 включительно (п. 9)        = 1,00;
//   бонус-малус (п. 10, вход дела)                           = 1,00.
//   8217,5 × 4,4 = 36 157,0; × 1,00 = 36 157,0; × 1,2 = 43 388,4 тенге.
//
// МРП ПОДАН ДЕЛОМ, И ЭТО ОГРАНИЧЕНИЕ РАННЕРА, А НЕ НОРМЫ: `applicable_mrp`
// выводится правилом `ApplicableMrp2026` из чужого пакета
// `kz.corpus.budget`, а раннер `.lawtest` исполняет ОДИН CLIR без линковки
// импортов. В общем прогоне семейства, где мир собран из снимков
// (`world = ["kz.corpus.ogpovts", "kz.corpus.budget", "kz.corpus.budget_code"]`),
// тот же факт приходит из бюджетного закона.
//
// Вход A3-таблицы пункта 9 подаётся фактом дела на внутреннем предикате
// `<id таблицы>/input` (§A3.3.4) — так же, как в раннере `corpus/kz/acts/ogpo_vts.py`.

// Срок уплаты по договору — 22 сентября 2026; проверка 17 сентября: срок не
// вышел, уплаты нет — обязанность действует и не нарушена.
//
// ДАТЫ ЭТИХ ДВУХ СЦЕН СДВИНУТЫ НА 13.09.2026, и сдвиг содержателен. Премия
// считается через коэффициент «бонус-малус», который выводит пакет
// `kz.corpus.bonus_malus`; его закреплённая редакция объявлена действующей с
// 12 сентября 2026 года (день получения байтов — дня первого официального
// опубликования поправки источник не называет). На прежнее `legal_time`
// 5 сентября проекция as-of §31 снимала подзаконный акт целиком, и премия не
// выводилась вовсе. Это верное поведение, а не помеха: пакет не отвечает о
// датах, на которые действие его редакции не установлено.
test "urn:query:ogpo-21-premiya-active" {
    given {
        context {
            decision_time @2026-09-17T12:00:00+05:00;
            knowledge_time @2026-09-17T12:00:00+05:00;
            legal_time @2026-09-17;
            timezone "Asia/Almaty";
        }
        assert "u21-a-a0": policyholder_of(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:insurer:i1")) { origin case_input; }
        assert "u21-a-a1": contract_concluded(entity_ref("urn:kz:ogpo:contract:c1")) { origin case_input; }
        assert "u21-a-a2": contract_concluded_on(entity_ref("urn:kz:ogpo:contract:c1"), @2026-09-13) { origin case_input; }
        assert "u21-a-a3": contract_premium_due_day(entity_ref("urn:kz:ogpo:contract:c1"), @2026-09-22) { origin case_input; }
        assert "u21-a-a4": applicable_mrp(4325 KZT) { origin case_input; }
        assert "u21-a-a5": territory_basis(entity_ref("urn:kz:ogpo:contract:c1"), TemporaryEntry) { origin case_input; }
        assert "u21-a-a6": vehicle_type_of(entity_ref("urn:kz:ogpo:contract:c1"), MotorVehicle) { origin case_input; }
        assert "u21-a-a7": insured_kind_of(entity_ref("urn:kz:ogpo:contract:c1"), LegalEntity) { origin case_input; }
        assert "u21-a-a8": vehicle_operation_term_years(entity_ref("urn:kz:ogpo:contract:c1"), 5) { origin case_input; }
        assert "u21-a-a9": "urn:kz:corpus:clir:ogpo-vts:table:operation-term-coefficient/input"(5) { origin case_input; }
        assert "u21-a-a10": raschet_bonus_malus_dogovora(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:bm:ogpo:c1-a")) { origin case_input; }
        assert "u21-a-a10-bm1": kz.corpus.bonus_malus::osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:ogpo:c1-a"), kz.corpus.bonus_malus::OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
        assert "u21-a-a10-bm2": kz.corpus.bonus_malus::deystvuyushchiy_klass(entity_ref("urn:kz:bm:ogpo:c1-a"), kz.corpus.bonus_malus::Klass3) { origin case_input; }
        assert "u21-a-a10-bm3": kz.corpus.bonus_malus::dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:ogpo:c1-a"), 269) { origin case_input; }
    }
    evaluate positions();
    expect position(UplatitStrakhovuyuPremiyu, ACTIVE);
    expect not position(UplatitStrakhovuyuPremiyu, VIOLATED);
    expect not position(UplatitStrakhovuyuPremiyu, SATISFIED);
}

// Премия уплачена в рассчитанном размере до истечения срока — исполнено.
