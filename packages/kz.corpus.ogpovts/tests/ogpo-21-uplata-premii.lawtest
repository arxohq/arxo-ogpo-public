        assert "u21-b-a3": contract_premium_due_day(entity_ref("urn:kz:ogpo:contract:c1"), @2026-09-22) { origin case_input; }
        assert "u21-b-a4": applicable_mrp(4325 KZT) { origin case_input; }
        assert "u21-b-a5": territory_basis(entity_ref("urn:kz:ogpo:contract:c1"), TemporaryEntry) { origin case_input; }
        assert "u21-b-a6": vehicle_type_of(entity_ref("urn:kz:ogpo:contract:c1"), MotorVehicle) { origin case_input; }
        assert "u21-b-a7": insured_kind_of(entity_ref("urn:kz:ogpo:contract:c1"), LegalEntity) { origin case_input; }
        assert "u21-b-a8": vehicle_operation_term_years(entity_ref("urn:kz:ogpo:contract:c1"), 5) { origin case_input; }
        assert "u21-b-a9": "urn:kz:corpus:clir:ogpo-vts:table:operation-term-coefficient/input"(5) { origin case_input; }
        assert "u21-b-a10": raschet_bonus_malus_dogovora(entity_ref("urn:kz:ogpo:contract:c1"), entity_ref("urn:kz:bm:ogpo:c1-b")) { origin case_input; }
        assert "u21-b-a10-bm1": kz.corpus.bonus_malus::osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:ogpo:c1-b"), kz.corpus.bonus_malus::OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
        assert "u21-b-a10-bm2": kz.corpus.bonus_malus::deystvuyushchiy_klass(entity_ref("urn:kz:bm:ogpo:c1-b"), kz.corpus.bonus_malus::Klass3) { origin case_input; }
        assert "u21-b-a10-bm3": kz.corpus.bonus_malus::dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:ogpo:c1-b"), 269) { origin case_input; }
        assert "u21-b-a11": premium_paid(entity_ref("urn:kz:ogpo:contract:c1"), 43388.4 KZT) { origin case_input; }
    }
    evaluate positions();
    expect position(UplatitStrakhovuyuPremiyu, SATISFIED);
    expect not position(UplatitStrakhovuyuPremiyu, VIOLATED);
}

