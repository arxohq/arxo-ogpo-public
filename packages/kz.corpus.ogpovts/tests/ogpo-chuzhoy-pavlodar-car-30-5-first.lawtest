language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// ПОРОЖДЁН tools/foreign_premium.py --emit из tools/foreign-premium-cases.json —
// не править руками. Ожидание выведено НЕЗАВИСИМОЙ моделью инструмента по
// закреплённым текстам (ст. 19 Закона № 446-II, Правила № 140, постановление
// АРРФР № 72), а не снято с ответа движка; чужие ответы и их квалификация —
// tests/foreign/REPORT.md.
//
// Дело pavlodar-car-30-5-first: Павлодарская область, легковой, 30 / 5, выпуск 2019, договор впервые (п. 4 Правил № 140: класс 3 с повышением на 20 %)

test "urn:query:ogpo-chuzhoy-pavlodar-car-30-5-first" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }
        assert "f0": territory_basis(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), CityOfOblastSignificance) { origin case_input; }
        assert "f1": registration_territory(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), PavlodarOblast) { origin case_input; }
        assert "f2": vehicle_type_of(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), PassengerCar) { origin case_input; }
        assert "f3": insured_kind_of(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), NaturalPerson) { origin case_input; }
        assert "f4": vehicle_operation_term_years(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), 7) { origin case_input; }
        assert "f5": "urn:kz:corpus:clir:ogpo-vts:table:operation-term-coefficient/input"(7) { origin case_input; }
        assert "f6": raschet_bonus_malus_dogovora(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), entity_ref("urn:kz:bm:ogpo:foreign-pavlodar-car-30-5-first")) { origin case_input; }
        assert "f7": insured_age_years(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), 30) { origin case_input; }
        assert "f8": driving_experience_years(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), 5) { origin case_input; }
        assert "f9": "urn:kz:corpus:clir:ogpo-vts:table:age-experience-coefficient/input"(30, 5) { origin case_input; }
        assert "f10": kz.corpus.bonus_malus::nepreryvnogo_strakhovaniya_270_dney_v_baze_net(entity_ref("urn:kz:bm:ogpo:foreign-pavlodar-car-30-5-first")) { origin case_input; }
    }
    evaluate truth(annual_premium_calculated(entity_ref("urn:kz:ogpo:contract:foreign-pavlodar-car-30-5-first"), 27546.644334 KZT));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
