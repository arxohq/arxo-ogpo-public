language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 8 п. 1, общий случай: страховая организация, не являющаяся вновь
// создаваемой, обязана заключить договор участия с Фондом гарантирования
// ДО получения лицензии (2026-09-20). Дело оценивается 2026-09-15 —
// внутри окна [@0001-01-01, 2026-09-20) — позиция ACTIVE.

test "urn:query:ogpo-art8-p1-existing-insurer-active" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art8-a0": license_obtained(entity_ref("urn:kz:ogpo:insurer:i1"), @2026-09-20) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(ZaklyuchitDogovorUchastiyaSFondomDoLitsenzii, ACTIVE);
    expect evaluation_status == COMPUTED;
}
