language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 9 п. 2: держатель информации о происшествии (суд, прокуратура,
// здравоохранение, иной государственный орган), к которому обратился
// страховщик, обязан её предоставить.

test "urn:query:ogpo-art9-p2-provide-accident-information" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art9-p2-a0": accident_information_requested_from(entity_ref("urn:kz:ogpo:body:court1"), entity_ref("urn:kz:ogpo:accident:a1")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(PredostavitInformatsiyuOProisshestvii, ACTIVE);
    expect evaluation_status == COMPUTED;
}
