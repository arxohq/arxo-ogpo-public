language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 8 п. 1, вновь создаваемая организация: срок — тридцать календарных
// дней с даты получения лицензии (2026-09-01 + 30 calendar_day = 2026-10-01,
// errata E-0109, без снимка §85). Дело оценивается 2026-09-15 — внутри
// [2026-09-01, 2026-10-01] — своя позиция ACTIVE, а общий срок «до лицензии»
// DEFEATED дефитером `unless newly_created_insurer`.

test "urn:query:ogpo-art8-p1-newly-created-insurer-active" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
            // Политика фиксированного календарного шага (errata E-0109):
            // roll no_roll, include_end true, без month_end — иначе
            // `add_calendar_period(at, 30 calendar_day)` даёт MISSING_POLICY.
            deadline_policy KZ_OGPO_CALENDAR_DAY_DEADLINES;
        }

        assert "art8-b0": license_obtained(entity_ref("urn:kz:ogpo:insurer:i2"), @2026-09-01) {
            origin case_input;
        }
        assert "art8-b1": newly_created_insurer(entity_ref("urn:kz:ogpo:insurer:i2")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(ZaklyuchitDogovorUchastiyaSFondomVTridtsatidnevnyySrok, ACTIVE);
    expect position(ZaklyuchitDogovorUchastiyaSFondomDoLitsenzii, DEFEATED);
    expect evaluation_status == COMPUTED;
}
