language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// ОСТАЛЬНЫЕ НОРМЫ СТАТЕЙ 10–15, у которых своей пары в других файлах нет.
// Файл существует затем, чтобы у КАЖДОГО правила модулей был исполняющий его
// сценарий: правило без сценария — обещание, а не норма.
//
// Здесь: свобода выбора страховщика и выбор способа заключения (позиции
// §128), обязанность уплатить премию, стандартный вид договора, обращение к
// страховщику как способ заключения, требования к полису комплексного
// договора, замещение ухудшающих условий (пункт 8), покрытие вреда самим
// страхователем и противоправно завладевшим лицом по обеим статьям, обмен
// цифровыми ресурсами через ресурс страховщика, два исключения пункта 1
// статьи 13 и два основания иного срока пункта 4.

context profile KZ_OGPO_DEADLINES {
    deadline_policy KZ_OGPO_CALENDAR_MONTH_DEADLINES;
}

context profile KZ_OGPO_DAY_DEADLINES {
    deadline_policy KZ_OGPO_CALENDAR_DAY_DEADLINES;
}

// Ст. 10 п. 3 абз. второй и четвёртый; п. 5 абз. второй; п. 4 подп. 1);
// п. 5-1 первый способ — на одном деле.
test "urn:query:ogpo-choice-and-premium-positions" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-x1-0": insurance_contract_of(entity_ref("urn:kz:ogpo:contract:y1"), entity_ref("urn:kz:ogpo:owner:o9"), entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }

        assert "ogpo-x1-1": insurance_application_submitted(entity_ref("urn:kz:ogpo:contract:y1"), entity_ref("urn:kz:ogpo:owner:o9"), entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }

        assert "ogpo-x1-2": conclusion_channel_used(entity_ref("urn:kz:ogpo:contract:y1"), DirectApplicationToInsurer) {
            origin case_input;
        }

        assert "ogpo-x1-3": vehicle_of(entity_ref("urn:kz:ogpo:vehicle:v14"), entity_ref("urn:kz:ogpo:owner:o9")) {
            origin case_input;
        }

        assert "ogpo-x1-4": insurer_licensed(entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect result_kind == NORM_POSITION;
    expect evaluation_status == COMPUTED;
    expect position(VybratStrakhovshchika, ACTIVE);
    expect position(VybratSposobZaklyucheniyaDogovora, ACTIVE);
    expect position(UplatitStrakhovuyuPremiyuPoDogovoru, ACTIVE);
}

