// Ст. 10 п. 8: договор заключён на ухудшающих условиях — при страховом случае
// обязательства страховщика определяются законом. Страховой случай выводится
// статьёй 22 пятью фактами дела.
test "urn:query:ogpo-worse-terms-replaced" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-x9-0": contract_terms_worsen_position(entity_ref("urn:kz:ogpo:contract:y9")) {
            origin case_input;
        }

        assert "ogpo-x9-1": contract_insured_person(entity_ref("urn:kz:ogpo:contract:y9"), entity_ref("urn:kz:ogpo:owner:o10")) {
            origin case_input;
        }

        assert "ogpo-x9-2": contract_covers_vehicle(entity_ref("urn:kz:ogpo:contract:y9"), entity_ref("urn:kz:ogpo:vehicle:v15")) {
            origin case_input;
        }

        assert "ogpo-x9-3": accident_arose_from_vehicle_operation(entity_ref("urn:kz:ogpo:accident:x4"), entity_ref("urn:kz:ogpo:owner:o10"), entity_ref("urn:kz:ogpo:vehicle:v15")) {
            origin case_input;
        }

        assert "ogpo-x9-4": victim_recognized(entity_ref("urn:kz:ogpo:accident:x4"), entity_ref("urn:kz:ogpo:victim:p4")) {
            origin case_input;
        }

        assert "ogpo-x9-5": property_harm_amount(entity_ref("urn:kz:ogpo:accident:x4"), entity_ref("urn:kz:ogpo:victim:p4"), 400000 KZT) {
            origin case_input;
        }
    }

    evaluate truth(insurer_obligations_governed_by_this_law(entity_ref("urn:kz:ogpo:contract:y9"), entity_ref("urn:kz:ogpo:accident:x4")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

