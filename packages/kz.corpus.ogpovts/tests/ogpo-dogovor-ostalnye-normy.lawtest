// Ст. 13 п. 1 подп. 2): пассажир перевозчика, обязанного страховать
// ответственность перед пассажирами.
test "urn:query:ogpo-carrier-passenger-excluded" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-x17-0": contract_insured_person(entity_ref("urn:kz:ogpo:contract:y17"), entity_ref("urn:kz:ogpo:owner:o15")) {
            origin case_input;
        }

        assert "ogpo-x17-1": contract_covers_vehicle(entity_ref("urn:kz:ogpo:contract:y17"), entity_ref("urn:kz:ogpo:vehicle:v17")) {
            origin case_input;
        }

        assert "ogpo-x17-2": accident_arose_from_vehicle_operation(entity_ref("urn:kz:ogpo:accident:x6"), entity_ref("urn:kz:ogpo:owner:o15"), entity_ref("urn:kz:ogpo:vehicle:v17")) {
            origin case_input;
        }

        assert "ogpo-x17-3": victim_recognized(entity_ref("urn:kz:ogpo:accident:x6"), entity_ref("urn:kz:ogpo:victim:p6")) {
            origin case_input;
        }

        assert "ogpo-x17-4": property_harm_amount(entity_ref("urn:kz:ogpo:accident:x6"), entity_ref("urn:kz:ogpo:victim:p6"), 300000 KZT) {
            origin case_input;
        }

        assert "ogpo-x17-5": victim_is_passenger(entity_ref("urn:kz:ogpo:contract:y17"), entity_ref("urn:kz:ogpo:victim:p6")) {
            origin case_input;
        }

        assert "ogpo-x17-6": insured_is_carrier_liable_to_passengers(entity_ref("urn:kz:ogpo:contract:y17")) {
            origin case_input;
        }
    }

    evaluate truth(contract_applies_to_victim(entity_ref("urn:kz:ogpo:contract:y17"), entity_ref("urn:kz:ogpo:victim:p6")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Ст. 13 п. 2 и п. 4 подп. 1): вступление в силу и сезонная эксплуатация.
// Политика §86 здесь с `month_end`: наименьший срок этого основания — шесть
// МЕСЯЦЕВ.
test "urn:query:ogpo-seasonal-ground-available" {
    given {
        context extends KZ_OGPO_DEADLINES {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-x18-0": contract_in_question(entity_ref("urn:kz:ogpo:contract:y18")) {
            origin case_input;
        }

        assert "ogpo-x18-1": contract_stipulated_start_day(entity_ref("urn:kz:ogpo:contract:y18"), @2026-01-01) {
            origin case_input;
        }

        assert "ogpo-x18-2": other_term_ground(entity_ref("urn:kz:ogpo:contract:y18"), SeasonalOperation) {
            origin case_input;
        }

        assert "ogpo-x18-3": contract_stipulated_end_day(entity_ref("urn:kz:ogpo:contract:y18"), @2026-08-01) {
            origin case_input;
        }

        assert "ogpo-x18-4": seasonal_operation(entity_ref("urn:kz:ogpo:contract:y18")) {
            origin case_input;
        }
    }

    evaluate truth(other_term_ground_available(entity_ref("urn:kz:ogpo:contract:y18"), SeasonalOperation));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Пара к сезонному основанию: договор с 1 января по 1 июня короче шести
// месяцев, наименьший допустимый день окончания — 1 июля.
test "urn:query:ogpo-seasonal-term-below-minimum" {
    given {
        context extends KZ_OGPO_DEADLINES {
