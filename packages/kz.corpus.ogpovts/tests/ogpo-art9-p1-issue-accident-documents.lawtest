language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 9 п. 1: орган внутренних дел, к которому обратились за документами о
// транспортном происшествии, обязан их выдать.

test "urn:query:ogpo-art9-p1-issue-accident-documents" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art9-p1-a0": accident_document_requested_from(entity_ref("urn:kz:ogpo:body:mvd1"), entity_ref("urn:kz:ogpo:accident:a1")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(VydatDokumentyOTransportnomProisshestvii, ACTIVE);
    expect evaluation_status == COMPUTED;
}
