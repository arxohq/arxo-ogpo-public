language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 15 п. 4 — ШКАЛА УДЕРЖАНИЯ: тринадцать строк, двенадцать стыков, и
// КАЖДЫЙ СТЫК ВЗЯТ С ОБЕИХ СТОРОН. Двадцать четыре сценария — это двенадцать
// пар: последний день нижней строки и первый день верхней.
//
// ПОЧЕМУ ГРАНИЦА ДОСТИЖИМА ТОЧНО. Договор действует с 1 января по 11 апреля
// 2026 года: N = 100 дней, и один день срока есть ровно один процент. На
// годовом договоре (N = 365) «четыре процента» пришлись бы на 14,6 суток, и
// проверить границу было бы нечем — не потому, что закон её не проводит, а
// потому, что дело до неё не дотягивается. Ста днями стык проверяется прямо.
//
// ЧТО ОТВЕЧАЕТ ЗАКОН НА САМОЙ ГРАНИЦЕ: строки шкалы написаны как «от X до Y
// (НЕ ВКЛЮЧАЯ Y)», и значение ровно Y принадлежит ВЕРХНЕЙ строке. Это сказано
// в тексте, а не выбрано формализатором: дыры между строками нет, наложения
// тоже — тринадцать полуинтервалов покрывают [0, +бесконечность).
//
// РАСЧЁТ РУКАМИ. n = days_between(1 января, день обращения) + 1, «включая день
// обращения»; процент прошедшего срока = n * 100 / N = n. Удержано =
// 100 000 тенге * доля строки. Так, обращение 4 января: n = 4, процент = 4,
// строка 2, доля 20 процентов, удержано 20 000 тенге.

context profile KZ_OGPO_DAY_DEADLINES {
    deadline_policy KZ_OGPO_CALENDAR_DAY_DEADLINES;
}

// n = 3: прошло 3 процентов срока — строка со ставкой 15 процентов,
// удержано 15000 тенге.
test "urn:query:ogpo-scale-n3" {
    given {
        context extends KZ_OGPO_DAY_DEADLINES {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-sc-1-0": contract_in_question(entity_ref("urn:kz:ogpo:contract:w1")) {
            origin case_input;
        }

        assert "ogpo-sc-1-1": contract_stipulated_start_day(entity_ref("urn:kz:ogpo:contract:w1"), @2026-01-01) {
            origin case_input;
        }

        assert "ogpo-sc-1-2": other_term_ground(entity_ref("urn:kz:ogpo:contract:w1"), TemporaryEntryToKz) {
            origin case_input;
        }

        assert "ogpo-sc-1-3": contract_stipulated_end_day(entity_ref("urn:kz:ogpo:contract:w1"), @2026-04-11) {
            origin case_input;
        }

        assert "ogpo-sc-1-4": early_termination_day(entity_ref("urn:kz:ogpo:contract:w1"), @2026-01-03) {
            origin case_input;
        }

        assert "ogpo-sc-1-5": premium_paid_amount(entity_ref("urn:kz:ogpo:contract:w1"), 100000 KZT) {
            origin case_input;
        }
    }

    evaluate truth(premium_retained(entity_ref("urn:kz:ogpo:contract:w1"), 15000 KZT));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

