// Возврат по шкале: n = 4, удержано 20 000, возвращается 100 000 − 20 000 =
// 80 000 тенге.
test "urn:query:ogpo-scale-refund" {
    given {
        context extends KZ_OGPO_DAY_DEADLINES {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-sc-25-0": contract_in_question(entity_ref("urn:kz:ogpo:contract:w25")) {
            origin case_input;
        }

        assert "ogpo-sc-25-1": contract_stipulated_start_day(entity_ref("urn:kz:ogpo:contract:w25"), @2026-01-01) {
            origin case_input;
        }

        assert "ogpo-sc-25-2": other_term_ground(entity_ref("urn:kz:ogpo:contract:w25"), TemporaryEntryToKz) {
            origin case_input;
        }

        assert "ogpo-sc-25-3": contract_stipulated_end_day(entity_ref("urn:kz:ogpo:contract:w25"), @2026-04-11) {
            origin case_input;
        }

        assert "ogpo-sc-25-4": early_termination_day(entity_ref("urn:kz:ogpo:contract:w25"), @2026-01-04) {
            origin case_input;
        }

        assert "ogpo-sc-25-5": premium_paid_amount(entity_ref("urn:kz:ogpo:contract:w25"), 100000 KZT) {
            origin case_input;
        }

        assert "ogpo-sc-25-6": civil_code_early_termination_ground(entity_ref("urn:kz:ogpo:contract:w25")) {
            origin case_input;
        }

        assert "ogpo-sc-25-7": early_termination_application_by_policyholder(entity_ref("urn:kz:ogpo:contract:w25")) {
            origin case_input;
        }
    }

    evaluate truth(premium_refunded(entity_ref("urn:kz:ogpo:contract:w25"), 80000 KZT));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
