            origin case_input;
        }

        assert "ogpo-t13-e2": other_term_ground(entity_ref("urn:kz:ogpo:contract:t5"), PriorToStateRegistration) {
            origin case_input;
        }

        assert "ogpo-t13-e3": contract_stipulated_end_day(entity_ref("urn:kz:ogpo:contract:t5"), @2026-01-04) {
            origin case_input;
        }
    }

    evaluate truth(contract_term_below_statutory_minimum(entity_ref("urn:kz:ogpo:contract:t5"), PriorToStateRegistration));

