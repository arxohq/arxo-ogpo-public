// Пункт 1: договор действует в отношении признанного потерпевшего. Страховой
// случай выводится статьёй 22 этого же пакета — пятью фактами дела.
test "urn:query:ogpo-contract-applies-to-victim" {
    given {
        context extends KZ_OGPO_DEADLINES {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-t13-g0": contract_insured_person(entity_ref("urn:kz:ogpo:contract:t7"), entity_ref("urn:kz:ogpo:owner:o1")) {
            origin case_input;
        }

        assert "ogpo-t13-g1": contract_covers_vehicle(entity_ref("urn:kz:ogpo:contract:t7"), entity_ref("urn:kz:ogpo:vehicle:v8")) {
            origin case_input;
        }

        assert "ogpo-t13-g2": accident_arose_from_vehicle_operation(entity_ref("urn:kz:ogpo:accident:x1"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:vehicle:v8")) {
            origin case_input;
        }

        assert "ogpo-t13-g3": victim_recognized(entity_ref("urn:kz:ogpo:accident:x1"), entity_ref("urn:kz:ogpo:victim:p1")) {
            origin case_input;
        }

        assert "ogpo-t13-g4": property_harm_amount(entity_ref("urn:kz:ogpo:accident:x1"), entity_ref("urn:kz:ogpo:victim:p1"), 500000 KZT) {
            origin case_input;
        }
    }

    evaluate truth(contract_applies_to_victim(entity_ref("urn:kz:ogpo:contract:t7"), entity_ref("urn:kz:ogpo:victim:p1")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Пара к предыдущему: тот же потерпевший — работник страхователя, на которого
// возложена обязанность страховать работников от несчастных случаев. Подпункт
// 3) пункта 1 выводит его из-под действия договора.
test "urn:query:ogpo-employee-victim-excluded" {
    given {
        context extends KZ_OGPO_DEADLINES {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-t13-h0": contract_insured_person(entity_ref("urn:kz:ogpo:contract:t8"), entity_ref("urn:kz:ogpo:owner:o1")) {
            origin case_input;
        }

        assert "ogpo-t13-h1": contract_covers_vehicle(entity_ref("urn:kz:ogpo:contract:t8"), entity_ref("urn:kz:ogpo:vehicle:v9")) {
            origin case_input;
        }

        assert "ogpo-t13-h2": accident_arose_from_vehicle_operation(entity_ref("urn:kz:ogpo:accident:x2"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:vehicle:v9")) {
            origin case_input;
        }

        assert "ogpo-t13-h3": victim_recognized(entity_ref("urn:kz:ogpo:accident:x2"), entity_ref("urn:kz:ogpo:victim:p2")) {
            origin case_input;
        }

        assert "ogpo-t13-h4": property_harm_amount(entity_ref("urn:kz:ogpo:accident:x2"), entity_ref("urn:kz:ogpo:victim:p2"), 500000 KZT) {
            origin case_input;
        }

        assert "ogpo-t13-h5": victim_is_employee_of_insured(entity_ref("urn:kz:ogpo:contract:t8"), entity_ref("urn:kz:ogpo:victim:p2")) {
            origin case_input;
        }

        assert "ogpo-t13-h6": insured_must_insure_employees(entity_ref("urn:kz:ogpo:contract:t8")) {
            origin case_input;
        }
    }

    evaluate truth(contract_applies_to_victim(entity_ref("urn:kz:ogpo:contract:t8"), entity_ref("urn:kz:ogpo:victim:p2")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

