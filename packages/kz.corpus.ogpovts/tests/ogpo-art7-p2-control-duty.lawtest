language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 7 п. 2: при проверке документов орган обязан проверить исполнение
// обязанности по заключению договора. Обязанность привязана к моменту
// проверки — окно [at, at].

test "urn:query:ogpo-art7-p2-control-duty" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art7-p2-a0": vehicle_documents_checked_at(entity_ref("urn:kz:ogpo:body:b1"), entity_ref("urn:kz:ogpo:vehicle:v1"), @2026-09-15) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(ProveritVypolnenieObyazannostiPoDogovoru, ACTIVE);
    expect evaluation_status == COMPUTED;
}
