language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// DECISION-0344 в статье 20. Льгота отводит ПРИМЕНИМОСТЬ уплаты премии в
// полном рассчитанном размере (`full_premium_applies(contract)`), а не
// величину статьи 19. Цель отмены беззначна, и потому под неё не подпадает ни
// одна сумма — ни чужая, ни тождественная.
//
// ЗАЧЕМ ЭТО ЗДЕСЬ ОСОБЕННО ВАЖНО. Прежняя запись била по литералу
// `premium_payable(contract, <рассчитанная премия>)`, и её корректность
// держалась на том, что рассчитанная премия не равна половине самой себя.
// Условие выполняется всюду, кроме нуля, — но оно держится на АРИФМЕТИКЕ
// СТАВКИ статьи 20 и нигде не записано: поправка, сменившая «пятьдесят
// процентов» на сто при каком-нибудь условии, погасила бы льготу целиком, без
// issue и без следа в proof. Сцена 3 предъявляет совпадение прямо — нулевой
// рассчитанной премией; величина синтетическая, свойство настоящее.
//
// ЧЕСТНАЯ ГРАНИЦА СЦЕНЫ 3. На ПРЕЖНЕЙ идиоме она тоже зелена: льготную
// величину выводит СТРОГОЕ `PremiumPayableReduced`, а «defeasible candidate
// никогда не побеждает strict support» (§107). Сцена закрепляет СВОЙСТВО и
// красна для формы, где цель отмены снова понесёт величину, и для правки,
// делающей опору статьи 20 поражаемой.

// 1. Льгота отводит ПРИМЕНИМОСТЬ полной премии.
test "urn:query:ogpo-20-primenimost-polnoy-premii-otvedena" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-20p-a0": standard_contract(entity_ref("urn:kz:ogpo:contract:f1")) {
            origin case_input;
        }
        assert "ogpo-20p-a1": owner_is_pensioner(entity_ref("urn:kz:ogpo:contract:f1")) {
            origin case_input;
        }
        assert "ogpo-20p-a2": annual_premium_calculated(entity_ref("urn:kz:ogpo:contract:f1"), 40000 KZT) {
            origin case_input;
        }
    }

    evaluate truth(full_premium_applies(entity_ref("urn:kz:ogpo:contract:f1")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// 2. И подлежащей уплате остаётся половина — поведение прежних дел статьи 20
//    сохраняется дословно.
test "urn:query:ogpo-20-lgotnaya-premiya-polovina" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-20p-b0": standard_contract(entity_ref("urn:kz:ogpo:contract:f2")) {
            origin case_input;
        }
        assert "ogpo-20p-b1": owner_is_pensioner(entity_ref("urn:kz:ogpo:contract:f2")) {
            origin case_input;
        }
        assert "ogpo-20p-b2": annual_premium_calculated(entity_ref("urn:kz:ogpo:contract:f2"), 40000 KZT) {
            origin case_input;
        }
    }

    evaluate truth(premium_payable(entity_ref("urn:kz:ogpo:contract:f2"), 20000 KZT));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// 3. САМОЕ ОПАСНОЕ ДЕЛО: льготная величина РАВНА полной. Вывод статьи 20 не
//    гаснет.
test "urn:query:ogpo-20-sovpadenie-velichin-ne-snimaet-lgotu" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-20p-c0": standard_contract(entity_ref("urn:kz:ogpo:contract:f3")) {
            origin case_input;
        }
        assert "ogpo-20p-c1": owner_is_pensioner(entity_ref("urn:kz:ogpo:contract:f3")) {
            origin case_input;
        }
        assert "ogpo-20p-c2": annual_premium_calculated(entity_ref("urn:kz:ogpo:contract:f3"), 0 KZT) {
            origin case_input;
        }
    }

    evaluate truth(premium_payable(entity_ref("urn:kz:ogpo:contract:f3"), 0 KZT));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
