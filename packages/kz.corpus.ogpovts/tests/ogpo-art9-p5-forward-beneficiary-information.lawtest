language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 9 п. 5 часть третья: организация по формированию и ведению базы
// данных, получившая сведения о случае причинения вреда жизни либо о
// родственных отношениях, направляет их страховщику участника происшествия.

test "urn:query:ogpo-art9-p5-forward-beneficiary-information" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art9-p5-a0": death_or_beneficiary_information_received_by(entity_ref("urn:kz:ogpo:org:baza1"), entity_ref("urn:kz:ogpo:accident:a1")) {
            origin case_input;
        }
        assert "art9-p5-a1": accident_insurer(entity_ref("urn:kz:ogpo:accident:a1"), entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(NapravitSvedeniyaStrakhovshchiku, ACTIVE);
    expect evaluation_status == COMPUTED;
}
