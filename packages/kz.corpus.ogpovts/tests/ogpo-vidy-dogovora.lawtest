// Ст. 11 п. 5 подп. 2): водитель по письменному трудовому договору.
test "urn:query:ogpo-standard-cover-driver-under-written-contract" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-a11-c0": standard_contract(entity_ref("urn:kz:ogpo:contract:k4")) {
            origin case_input;
        }

        assert "ogpo-a11-c1": contract_insured_person(entity_ref("urn:kz:ogpo:contract:k4"), entity_ref("urn:kz:ogpo:owner:o1")) {
            origin case_input;
        }

        assert "ogpo-a11-c2": driver_under_written_contract_with_insured(entity_ref("urn:kz:ogpo:contract:k4"), entity_ref("urn:kz:ogpo:owner:d1")) {
            origin case_input;
        }

        assert "ogpo-a11-c3": harm_to_third_party_caused_by(entity_ref("urn:kz:ogpo:contract:k4"), entity_ref("urn:kz:ogpo:owner:d1")) {
            origin case_input;
        }
    }

    evaluate truth(liability_insured_under_standard_contract(entity_ref("urn:kz:ogpo:contract:k4"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:owner:d1")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Тот же водитель по тому же письменному договору — предикат моста к статье 28.
test "urn:query:ogpo-insured-answers-for-driver-bridge" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
