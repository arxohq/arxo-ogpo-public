    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Пара к мосту: подпункт 3) даёт ПОКРЫТИЕ, но не даёт основания пункта 2
// статьи 28 — он в перечне этого пункта не назван.
test "urn:query:ogpo-unlawful-taker-covered-but-not-in-bridge" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-a11-e0": standard_contract(entity_ref("urn:kz:ogpo:contract:k6")) {
            origin case_input;
        }

        assert "ogpo-a11-e1": contract_insured_person(entity_ref("urn:kz:ogpo:contract:k6"), entity_ref("urn:kz:ogpo:owner:o1")) {
            origin case_input;
        }

        assert "ogpo-a11-e2": driver_unlawfully_took_vehicle(entity_ref("urn:kz:ogpo:contract:k6"), entity_ref("urn:kz:ogpo:owner:d2")) {
            origin case_input;
        }

        assert "ogpo-a11-e3": liability_imposed_on_insured_for_unlawful_taking(entity_ref("urn:kz:ogpo:contract:k6"), entity_ref("urn:kz:ogpo:owner:d2")) {
            origin case_input;
        }

        assert "ogpo-a11-e4": harm_to_third_party_caused_by(entity_ref("urn:kz:ogpo:contract:k6"), entity_ref("urn:kz:ogpo:owner:d2")) {
            origin case_input;
        }
    }

    evaluate truth(standard_contract_insured_answers_for_driver(entity_ref("urn:kz:ogpo:contract:k6"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:owner:d2")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Ст. 12 п. 1: две единицы транспорта у физического лица — комплексный
// договор доступен.
test "urn:query:ogpo-complex-contract-two-vehicles" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-a12-a0": complex_contract(entity_ref("urn:kz:ogpo:contract:k7")) {
            origin case_input;
        }

        assert "ogpo-a12-a1": insured_kind_of(entity_ref("urn:kz:ogpo:contract:k7"), NaturalPerson) {
            origin case_input;
        }

        assert "ogpo-a12-a2": contract_insured_person(entity_ref("urn:kz:ogpo:contract:k7"), entity_ref("urn:kz:ogpo:owner:o2")) {
            origin case_input;
        }

        assert "ogpo-a12-a3": vehicle_of(entity_ref("urn:kz:ogpo:vehicle:v3"), entity_ref("urn:kz:ogpo:owner:o2")) {
            origin case_input;
        }

        assert "ogpo-a12-a4": vehicle_of(entity_ref("urn:kz:ogpo:vehicle:v4"), entity_ref("urn:kz:ogpo:owner:o2")) {
            origin case_input;
        }
    }

    evaluate truth(complex_contract_available_to_insured(entity_ref("urn:kz:ogpo:contract:k7"), entity_ref("urn:kz:ogpo:owner:o2")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

