        }
    }

    evaluate truth(standard_contract_insures_owner(entity_ref("urn:kz:ogpo:contract:k2"), entity_ref("urn:kz:ogpo:owner:o1")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

