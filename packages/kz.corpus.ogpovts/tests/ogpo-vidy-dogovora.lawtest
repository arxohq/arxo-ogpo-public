language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 10 п. 4, ст. 11 пп. 1, 2 и 5, ст. 12 пп. 1, 2 и 5 — виды договора и то,
// чья ответственность по каждому из них считается застрахованной.
//
// ГЛАВНАЯ ПАРА ФАЙЛА — РАЗНИЦА МЕЖДУ СТАТЬЯМИ 11 И 12. Пункт 5 статьи 11
// знает управление по трудовому или иному письменному договору; пункт 5
// статьи 12 такого подпункта НЕ ЗНАЕТ. Два сценария на одних и тех же фактах,
// отличающихся только видом договора, показывают эту разницу ответом:
// стандартный договор ответственность страхует, комплексный — нет. Сведи
// статьи к одному предикату — и первая половина пары останется зелёной, а
// вторая станет ложью.
//
// ВТОРАЯ ПАРА — МОСТ К ПУНКТУ 2 СТАТЬИ 28. Подпункты 1) и 2) пункта 5
// статьи 11 дают `standard_contract_insured_answers_for_driver`, подпункт 3) —
// нет: пункт 2 статьи 28 называет только первые два. Пара сторожит именно эту
// границу, потому что покрытие ответственности даёт и подпункт 3).
//
// ТРЕТЬЯ ПАРА — ПОРОГ ПУНКТА 1 СТАТЬИ 12: две единицы транспорта против одной.

test "urn:query:ogpo-contract-kind-established" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-p4-a0": complex_contract(entity_ref("urn:kz:ogpo:contract:k1")) {
            origin case_input;
        }
    }

    evaluate truth(contract_kind_established(entity_ref("urn:kz:ogpo:contract:k1")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

