        }
    }

    evaluate truth(standard_contract_insured_answers_for_driver(entity_ref("urn:kz:ogpo:contract:k5"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:owner:d1")));

