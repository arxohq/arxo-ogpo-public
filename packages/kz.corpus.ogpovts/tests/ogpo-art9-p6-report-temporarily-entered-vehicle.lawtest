language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 9 п. 6: таможенный либо пограничный орган обязан представить сведения
// о временно въехавшем транспортном средстве в организацию по формированию
// и ведению базы данных.

test "urn:query:ogpo-art9-p6-report-temporarily-entered-vehicle" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art9-p6-a0": vehicle_temporarily_entered_kz(entity_ref("urn:kz:ogpo:vehicle:v1")) {
            origin case_input;
        }
        assert "art9-p6-a1": border_or_customs_body_for(entity_ref("urn:kz:ogpo:vehicle:v1"), entity_ref("urn:kz:ogpo:body:customs1")) {
            origin case_input;
        }
        assert "art9-p6-a2": database_organization_registered(entity_ref("urn:kz:ogpo:org:baza1")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(PredstavitSvedeniyaOVremennoVieekhavshemTS, ACTIVE);
    expect evaluation_status == COMPUTED;
}
