test "urn:query:ogpo-p14-temporary-entry-amount" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
            deadline_policy KZ_OGPO_CALENDAR_MONTH_DEADLINES;
        }
        assert "p14c-0": territory_basis(entity_ref("urn:kz:ogpo:contract:short-3"), TemporaryEntry) { origin case_input; }
        assert "p14c-3": vehicle_type_of(entity_ref("urn:kz:ogpo:contract:short-3"), MotorVehicle) { origin case_input; }
        assert "p14c-4": insured_kind_of(entity_ref("urn:kz:ogpo:contract:short-3"), NaturalPerson) { origin case_input; }
        assert "p14c-5": insured_age_years(entity_ref("urn:kz:ogpo:contract:short-3"), 30) { origin case_input; }
        assert "p14c-6": driving_experience_years(entity_ref("urn:kz:ogpo:contract:short-3"), 5) { origin case_input; }
        assert "p14c-7": vehicle_operation_term_years(entity_ref("urn:kz:ogpo:contract:short-3"), 3) { origin case_input; }
        assert "p14c-8": raschet_bonus_malus_dogovora(entity_ref("urn:kz:ogpo:contract:short-3"), entity_ref("urn:kz:bm:ogpo:short-3")) { origin case_input; }
        assert "p14c-8-bm1": kz.corpus.bonus_malus::vremennyy_vezd_na_territoriyu_rk(entity_ref("urn:kz:bm:ogpo:short-3")) { origin case_input; }
        assert "p14c-9": "urn:kz:corpus:clir:ogpo-vts:table:age-experience-coefficient/input"(30, 5) { origin case_input; }
        assert "p14c-10": "urn:kz:corpus:clir:ogpo-vts:table:operation-term-coefficient/input"(3) { origin case_input; }
        assert "p14c-11": contract_starts_on(entity_ref("urn:kz:ogpo:contract:short-3"), @2026-03-01) { origin case_input; }
        assert "p14c-12": contract_term_days(entity_ref("urn:kz:ogpo:contract:short-3"), 90) { origin case_input; }
        assert "p14c-13": temporary_entry_term_band(entity_ref("urn:kz:ogpo:contract:short-3"), ThreeMonths) { origin case_input; }
    }
    evaluate collect amount: Money where short_term_insurance_premium(entity_ref("urn:kz:ogpo:contract:short-3"), amount);
    expect result_kind == COLLECTION;
    expect collected_count(1);
    expect evaluation_status == COMPUTED;
}
