language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 8 п. 3: владелец вправе заключить договор с иностранным страховщиком,
// если тот покрывает риск только за пределами Казахстана.

test "urn:query:ogpo-art8-p3-foreign-insurer-liberty" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art8-p3-a0": foreign_insurance_covers_only_outside_kz(entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:vehicle:v1")) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(MozhetZaklyuchitDogovorSInostrannymStrakhovshchikom, ACTIVE);
    expect evaluation_status == COMPUTED;
}
