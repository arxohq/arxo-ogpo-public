language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 7 п. 1: без заключённого договора обязательного страхования запрет
// эксплуатации ТС активен. Верхняя сторона пары — нижняя,
// ogpo-art7-p1-prohibition-defeated, снимает запрет заключённым договором.

test "urn:query:ogpo-art7-p1-prohibition-active" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "art7-a0": vehicle_of(entity_ref("urn:kz:ogpo:vehicle:v1"), entity_ref("urn:kz:ogpo:owner:o1")) {
            origin case_input;
        }
        assert "art7-a1": compulsory_insurance_ground(entity_ref("urn:kz:ogpo:vehicle:v1"), RegisteredVehicle) {
            origin case_input;
        }
    }

    evaluate positions();

    expect position(EkspluatatsiyaBezDogovoraNeDopuskaetsya, ACTIVE);
    expect not position(EkspluatatsiyaBezDogovoraNeDopuskaetsya, DEFEATED);
    expect evaluation_status == COMPUTED;
}
