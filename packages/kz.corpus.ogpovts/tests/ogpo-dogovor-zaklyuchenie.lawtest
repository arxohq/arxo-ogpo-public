            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-p5-a0": electronic_policy_issued(entity_ref("urn:kz:ogpo:contract:c5"), entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }
    }

    evaluate truth(contract_concluded(entity_ref("urn:kz:ogpo:contract:c5")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "urn:query:ogpo-digital-channel-permitted" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-p51-a0": conclusion_channel_used(entity_ref("urn:kz:ogpo:contract:c6"), DigitalResourceExchange) {
            origin case_input;
        }
    }

    evaluate truth(conclusion_channel_permitted(entity_ref("urn:kz:ogpo:contract:c6"), DigitalResourceExchange));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// П. 5-2: транспортное средство вне международного движения и государственной
// регистрации не подлежит — заключение договора запрещено.
test "urn:query:ogpo-conclusion-forbidden-unregistered" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-p52-a0": insurance_application_submitted(entity_ref("urn:kz:ogpo:contract:c7"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }

        assert "ogpo-p52-a1": contract_covers_vehicle(entity_ref("urn:kz:ogpo:contract:c7"), entity_ref("urn:kz:ogpo:vehicle:v1")) {
            origin case_input;
        }

        assert "ogpo-p52-a2": international_movement_status(entity_ref("urn:kz:ogpo:vehicle:v1"), NotInInternationalMovement) {
            origin case_input;
        }

        assert "ogpo-p52-a3": vehicle_registration_status(entity_ref("urn:kz:ogpo:vehicle:v1"), NeitherRegisteredNorSubjectToRegistration) {
            origin case_input;
        }
    }

    evaluate positions();

    expect result_kind == NORM_POSITION;
    expect evaluation_status == COMPUTED;
    expect position(ZaklyuchitDogovorVneMezhdunarodnogoDvizheniya, ACTIVE);
}

// Пара: то же дело, но транспортное средство подлежит государственной
// регистрации — исключение пункта 5-2 снимает запрет.
test "urn:query:ogpo-conclusion-allowed-registered" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-p52-b0": insurance_application_submitted(entity_ref("urn:kz:ogpo:contract:c8"), entity_ref("urn:kz:ogpo:owner:o1"), entity_ref("urn:kz:ogpo:insurer:i1")) {
            origin case_input;
        }

        assert "ogpo-p52-b1": contract_covers_vehicle(entity_ref("urn:kz:ogpo:contract:c8"), entity_ref("urn:kz:ogpo:vehicle:v2")) {
            origin case_input;
        }

        assert "ogpo-p52-b2": international_movement_status(entity_ref("urn:kz:ogpo:vehicle:v2"), NotInInternationalMovement) {
            origin case_input;
        }

        assert "ogpo-p52-b3": vehicle_registration_status(entity_ref("urn:kz:ogpo:vehicle:v2"), RegisteredOrSubjectToRegistration) {
            origin case_input;
        }
    }

    evaluate positions();

    expect result_kind == NORM_POSITION;
    expect evaluation_status == COMPUTED;
    expect not position(ZaklyuchitDogovorVneMezhdunarodnogoDvizheniya, ACTIVE);
}
