language "law.core" version "0.2";
package kz.corpus.ogpovts version "0.1.0";
namespace "urn:kz:corpus:clir:ogpo-vts";

// Ст. 20 ч. 1 обусловливает льготу словами «при заключении стандартного
// договора». Дело называет льготную категорию и МОЛЧИТ о виде договора —
// льготы нет. Третья сторона тройки; она же сторожит границу замыкания §70:
// домен замыкания объявлен по `standard_contract`, и на деле без него
// вопрос о других владельцах не возникает вовсе.

test "urn:query:ogpo-reduction-needs-standard-contract" {
    given {
        context {
            decision_time @2026-09-15T12:00:00+05:00;
            knowledge_time @2026-09-15T12:00:00+05:00;
            legal_time @2026-09-15;
            timezone "Asia/Almaty";
        }

        assert "ogpo-red-s-a0": owner_is_pensioner(entity_ref("urn:kz:ogpo:contract:c1")) {
            origin case_input;
        }
    }

    evaluate truth(premium_reduction_applies(entity_ref("urn:kz:ogpo:contract:c1")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
