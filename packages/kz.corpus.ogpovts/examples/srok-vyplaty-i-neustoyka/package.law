language "law.core" version "0.2";
package examples.ogpovts.srok_vyplaty_i_neustoyka version "0.1.0";
namespace "urn:law:examples:ogpo-vts:srok-vyplaty-i-neustoyka";

import kz.corpus.ogpovts version "0.1.0";
import kz.corpus.strakhovaya_neustoyka version "0.1.0";
import kz.corpus.clir.official_calendar version "0.1.0";

// Порядок исчисления §86 — общий для права РК (ГК статьи 173, 176), тот же,
// что у сценариев канона (`KZ_OGPO_SLUCHAY_DEADLINES`): срок в N рабочих
// дней истекает в N-й рабочий день ПОСЛЕ дня события.
deadline policy OGPO_RABOCHIE_DNI {
    start_count next_day;
    include_end true;
    roll next_working_day;
}
