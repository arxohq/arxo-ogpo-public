language "law.core" version "0.2";
package examples.ogpovts.srok_vyplaty_i_neustoyka version "0.1.0";
namespace "urn:law:examples:ogpo-vts:srok-vyplaty-i-neustoyka";

// Срок, проходящий через ПРАЗДНИК и перенесённый день отдыха.
// Документы получены в понедельник 19 октября 2026. День Республики —
// 25 октября — приходится на воскресенье и переносится на понедельник
// 26 октября (абзац 3 статьи 5 закона о праздниках; в снимке календаря обе
// даты нерабочие). Пятнадцать рабочих дней: 20, 21, 22, 23, 27, 28, 29,
// 30 октября, 2, 3, 4, 5, 6, 9, 10 ноября → срок истекает во вторник
// 10 ноября 2026. Счёт «по выходным без праздника» дал бы 9 ноября — и
// выплату 10 ноября сочли бы просроченной на день. По календарю она в срок.
case CherezPrazdnik {
    context {
        legal_time @2026-11-20;
        knowledge_time @2026-11-20T12:00:00+05:00;
        decision_time @2026-11-20T12:00:00+05:00;
        timezone "Asia/Almaty";
        deadline_policy OGPO_RABOCHIE_DNI;
        calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
    }

    const trebovanie: kz.corpus.ogpovts::PaymentClaim = entity_ref("urn:example:ogpo:trebovanie");
    const proisshestvie: kz.corpus.ogpovts::TrafficAccident = entity_ref("urn:example:ogpo:proisshestvie");

    assert "trebovanie": kz.corpus.ogpovts::payment_claim_of(trebovanie, proisshestvie, entity_ref("urn:example:ogpo:vygodopriobretatel"), entity_ref("urn:example:ogpo:strakhovshchik")) { origin case_input; }
    assert "vygodopriobretatel": kz.corpus.ogpovts::beneficiary_of_victim(proisshestvie, entity_ref("urn:example:ogpo:poterpevshiy"), entity_ref("urn:example:ogpo:vygodopriobretatel")) { origin case_input; }
    assert "razmer-vyplaty": kz.corpus.ogpovts::insurance_payment_amount(proisshestvie, entity_ref("urn:example:ogpo:poterpevshiy"), 730000 KZT) { origin case_input; }
    assert "dokumenty-polucheny": kz.corpus.ogpovts::documents_received_on(trebovanie, @2026-10-19) { origin case_input; }
    assert "vyplata": kz.corpus.ogpovts::strakhovaya_vyplata_osushchestvlena(trebovanie, @2026-11-10) { origin case_input; }
    assert "nachislenie": kz.corpus.strakhovaya_neustoyka::nachislenie_po_trebovaniyu(trebovanie, entity_ref("urn:example:ogpo:nachislenie")) { origin case_input; }
    assert "den-ispolneniya": kz.corpus.strakhovaya_neustoyka::den_ispolneniya_denezhnogo_obyazatelstva(trebovanie, @2026-11-10) { origin case_input; }
    assert "delitel-goda": kz.corpus.strakhovaya_neustoyka::prinyatyy_delitel_goda(trebovanie, 365.0) { origin case_input; }
}
