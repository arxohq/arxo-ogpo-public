// СТАТЬЯ 9. ИНФОРМАЦИОННОЕ ВЗАИМОДЕЙСТВИЕ.
//
// Шесть пунктов; из них ЧЕТЫРЕ дают обязанность конкретного органа с
// конкретным адресатом и предметом, ДВА (пункт 4 целиком и первые два
// абзаца пункта 5) — только КАНАЛ обмена («путём обмена цифровыми
// ресурсами», «посредством единой базы данных») без нового носителя или
// предмета сверх уже выведенных пунктами 1–3 и третьим абзацем пункта 5, и
// потому граница: канал не меняет, обязан ли орган и что именно передать,
// он только называет техническое средство передачи.
//
// РЕШЕНИЕ ФОРМАЛИЗАТОРА (упрощение, не меняющее ответа по делу): пункты 1 и
// 2 называют НЕСКОЛЬКИХ адресатов/держателей информации союзом «а также» —
// участники, представители, страховые организации и омбудсман (пункт 1);
// органы внутренних дел, прокуратуры, суды, здравоохранение, «иные
// государственные органы и организации» (пункт 2). Последствие («выдать»,
// «предоставить») одно и то же независимо от того, КТО именно запросил или
// какой ИМЕННО орган держит информацию, и различение по личности запросившего
// не меняет исхода ни одного дела корпуса — поэтому обязанность взята по
// органу-держателю с обобщённым фактом запроса, а не по каждому адресату и
// каждому держателю отдельным правилом. Если позже понадобится различить
// ответ по личности адресата (например отдельный срок для омбудсмана),
// решение пересматривается тем же нарядом, который его вводит.
//
// СТАТЬЯ 32 — ГРАНИЦА ЦЕЛИКОМ (сама статья ниже правил не имеет). Текст
// разрешает участие Республики Казахстан в международных системах
// обязательного страхования «в порядке, предусмотренном законодательством
// Республики Казахстан» — свобода ГОСУДАРСТВА как участника международных
// систем, не частного лица, и её условие — порядок, установленный ДРУГИМ,
// пока не формализованным актом. Ни носителя-участника дела, ни собственного
// условия статья не называет: она открывает дверь для будущего акта о
// конкретной системе (аналог «зелёной карты»), а не действует сама. Причина
// внесена в `sources/ogpo-vts/articles.json`.

// ============================================================================
// Статья 9 пункт 1: выдача документов о происшествии
// ============================================================================

entity InternalAffairsBody {
    label ru-KZ official "орган внутренних дел Республики Казахстан (статья 9)";
}

relation accident_document_requested_from(body: InternalAffairsBody, accident: TrafficAccident)
    kind empirical {
    label ru-KZ official "участник транспортного происшествия, его представитель, страховая организация либо страховой омбудсман запросили у названного органа документы о происшествии";
}

relation accident_document_issued_by(body: InternalAffairsBody, accident: TrafficAccident)
    kind empirical {
    label ru-KZ official "орган внутренних дел выдал документы, подтверждающие факт наступления события, имеющего признаки страхового случая, по названному происшествию";
}

@source(LAW_446_ART9)
rule InternalAffairsMustIssueAccidentDocuments(body: InternalAffairsBody, accident: TrafficAccident) strict {
    label ru-KZ official "Статья 9 пункт 1. Органы внутренних дел Республики Казахстан выдают по одному экземпляру участникам транспортного происшествия либо их представителям, а также страховым организациям, страховому омбудсману по их запросу документы, подтверждающие факт наступления события, имеющего признаки страхового случая";
    when accident_document_requested_from(body: body, accident: accident);
    then duty VydatDokumentyOTransportnomProisshestvii {
        bearer body;
        achieve accident_document_issued_by(body, accident) during [@2026-07-23, infinity);
    };
}

// ============================================================================
// Статья 9 пункт 2: предоставление информации страховщику
// ============================================================================

entity InformationHolderBody {
    label ru-KZ official "орган внутренних дел, орган прокуратуры, суд, организация здравоохранения либо иной государственный орган или организация, располагающие информацией о транспортном происшествии (статья 9 пункт 2)";
}

relation accident_information_requested_from(body: InformationHolderBody, accident: TrafficAccident)
    kind empirical {
    label ru-KZ official "страховщик, страховой омбудсман либо Фонд гарантирования страховых выплат обратились к названному органу за информацией о транспортном происшествии и его последствиях";
}

relation accident_information_provided_by(body: InformationHolderBody, accident: TrafficAccident)
    kind empirical {
    label ru-KZ official "орган предоставил информацию о транспортном происшествии и его последствиях";
}

@source(LAW_446_ART9, quote = "Органы внутренних дел, органы прокуратуры, суды, организации здравоохранения, иные государственные органы и организации, располагающие информацией о транспортном происшествии и его последствиях, обязаны предоставить данную информацию страховщику, страховому омбудсману и Фонду гарантирования страховых выплат при их обращении и (или) при обмене цифровыми ресурсами.")
rule InformationHolderMustProvideAccidentInformation(body: InformationHolderBody, accident: TrafficAccident) strict {
    label ru-KZ official "Статья 9 пункт 2. Органы внутренних дел, органы прокуратуры, суды, организации здравоохранения, иные государственные органы и организации, располагающие информацией о транспортном происшествии и его последствиях, обязаны предоставить данную информацию страховщику, страховому омбудсману и Фонду гарантирования страховых выплат при их обращении";
    when accident_information_requested_from(body: body, accident: accident);
    then duty PredostavitInformatsiyuOProisshestvii {
        bearer body;
        achieve accident_information_provided_by(body, accident) during [@2026-07-23, infinity);
    };
}

// ============================================================================
// Статья 9 пункт 3: информирование страховщика при невозможности сообщения
// ============================================================================
//
// Обязанность УСЛОВНАЯ: наступает только когда сообщить не может ни
// страхователь (застрахованный), ни потерпевший, ни их наследники —
// названо ОДНИМ фактом дела, потому что закон не даёт для каждого из троих
// отдельного порядка её проверки: различение личности того, кто не смог
// сообщить, не меняет обязанности органа. Компетентный орган по данному
// происшествию — факт дела (статья 6 пункт 2 называет вид органа, но не то,
// какое ИМЕННО подразделение ведёт данное происшествие).

relation reporting_by_parties_impossible(accident: TrafficAccident) kind empirical {
    label ru-KZ official "страхователь (застрахованный), потерпевший или их наследники не могут сообщить о наступлении транспортного происшествия";
}

relation traffic_control_body_for(accident: TrafficAccident, body: TrafficControlBody) kind empirical {
    label ru-KZ official "названное подразделение уполномоченного органа по обеспечению безопасности дорожного движения ведёт данное транспортное происшествие";
}

// `accident_insurer` уже объявлено статьёй 24 (`24-predely-otvetstvennosti.law`)
// с той же сигнатурой — страховщик, к которому обращаются по данному
// происшествию; здесь она читается, а не заводится второй раз.

relation accident_reported_to_insurer_by(body: TrafficControlBody, accident: TrafficAccident, insurer: Insurer)
    kind empirical {
    label ru-KZ official "подразделение уполномоченного органа сообщило страховщику о транспортном происшествии";
}

@source(LAW_446_ART9, quote = "При невозможности сообщения страхователем (застрахованным), потерпевшим или их наследниками о наступлении транспортного происшествия подразделения уполномоченного органа по обеспечению безопасности дорожного движения осуществляют информирование соответствующего страховщика о данном транспортном происшествии.")
rule TrafficControlMustInformInsurerWhenReportingImpossible(
    body: TrafficControlBody,
    accident: TrafficAccident,
    insurer: Insurer,
) strict {
    label ru-KZ official "Статья 9 пункт 3. При невозможности сообщения страхователем (застрахованным), потерпевшим или их наследниками о наступлении транспортного происшествия подразделения уполномоченного органа по обеспечению безопасности дорожного движения осуществляют информирование соответствующего страховщика о данном транспортном происшествии";
    when reporting_by_parties_impossible(accident: accident);
    when traffic_control_body_for(accident: accident, body: body);
    when accident_insurer(accident: accident, insurer: insurer);
    then duty InformirovatStrakhovshchikaOProisshestvii {
        bearer body;
        achieve accident_reported_to_insurer_by(body, accident, insurer) during [@2026-07-23, infinity);
    };
}

// ============================================================================
// Статья 9 пункт 5 (часть третья): организация направляет сведения страховщику
// ============================================================================
//
// Взята ТОЛЬКО часть третья пункта 5 — обязанность организации по ведению
// базы данных направить страховщику сведения, полученные по частям первой и
// второй (обмен со статистическим органом и с держателем сведений о
// родственных отношениях). Сам обмен, дающий организации эти сведения, —
// канал (см. шапку) и в срез не взят; взято его РЕЗУЛЬТАТ как факт дела.

entity DatabaseOrganization {
    label ru-KZ official "организация по формированию и ведению базы данных по страхованию (статья 9)";
}

relation death_or_beneficiary_information_received_by(org: DatabaseOrganization, accident: TrafficAccident)
    kind empirical {
    label ru-KZ official "организация по формированию и ведению базы данных получила сведения о случае причинения вреда жизни потерпевшего либо сведения, подтверждающие родственные отношения заявителя с умершим, по названному происшествию";
}

relation beneficiary_information_forwarded_to_insurer_by(
    org: DatabaseOrganization,
    accident: TrafficAccident,
    insurer: Insurer,
) kind empirical {
    label ru-KZ official "организация направила полученные сведения страховщику, заключившему договор обязательного страхования с участником происшествия";
}

@source(LAW_446_ART9)
rule DatabaseOrgMustForwardBeneficiaryInformationToInsurer(
    org: DatabaseOrganization,
    accident: TrafficAccident,
    insurer: Insurer,
) strict {
    label ru-KZ official "Статья 9 пункт 5 часть третья. Организация по формированию и ведению базы данных направляет полученную информацию страховщику, заключившему договор обязательного страхования ответственности владельцев транспортных средств с участником данного транспортного происшествия";
    when death_or_beneficiary_information_received_by(org: org, accident: accident);
    when accident_insurer(accident: accident, insurer: insurer);
    then duty NapravitSvedeniyaStrakhovshchiku {
        bearer org;
        achieve beneficiary_information_forwarded_to_insurer_by(org, accident, insurer) during [@2026-07-23, infinity);
    };
}

// ============================================================================
// Статья 9 пункт 6: сведения о временно въехавших ТС
// ============================================================================

entity BorderOrCustomsBody {
    label ru-KZ official "уполномоченный орган в сфере таможенного дела, защиты и охраны Государственной границы Республики Казахстан либо иной государственный орган (статья 9 пункт 6)";
}

relation vehicle_temporarily_entered_kz(vehicle: Vehicle) kind empirical {
    label ru-KZ official "транспортное средство временно въехало (ввезено) на территорию Республики Казахстан";
}

relation database_organization_registered(org: DatabaseOrganization) kind empirical {
    label ru-KZ official "названная организация ведёт единую базу данных по страхованию, которой статья 9 адресует сведения";
}

// Свидетель наличия компетентного органа по этому транспортному средству
// (приём E-0165: без него `body` в норм-голове не связан — §190).
relation border_or_customs_body_for(vehicle: Vehicle, body: BorderOrCustomsBody) kind empirical {
    label ru-KZ official "названный уполномоченный орган в сфере таможенного дела либо охраны Государственной границы представляет сведения о данном транспортном средстве";
}

relation vehicle_information_reported_to_database_org(
    body: BorderOrCustomsBody,
    vehicle: Vehicle,
    org: DatabaseOrganization,
) kind empirical {
    label ru-KZ official "орган представил сведения о временно въехавшем транспортном средстве в организацию по формированию и ведению базы данных";
}

@source(LAW_446_ART9)
rule BorderBodyMustReportTemporarilyEnteredVehicleInfo(
    body: BorderOrCustomsBody,
    vehicle: Vehicle,
    org: DatabaseOrganization,
) strict {
    label ru-KZ official "Статья 9 пункт 6. Уполномоченные органы в сфере таможенного дела, защиты и охраны Государственной границы Республики Казахстан и иные государственные органы представляют сведения о транспортных средствах, временно въехавших (ввезенных) на территорию Республики Казахстан, в организацию по формированию и ведению базы данных";
    when vehicle_temporarily_entered_kz(vehicle: vehicle);
    when border_or_customs_body_for(vehicle: vehicle, body: body);
    when database_organization_registered(org: org);
    then duty PredstavitSvedeniyaOVremennoVieekhavshemTS {
        bearer body;
        achieve vehicle_information_reported_to_database_org(body, vehicle, org) during [@2026-07-23, infinity);
    };
}
