language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 129. Принцип непрерывности деятельности: если намерение либо необходимость ликвидации или существенного сокращения масштабов деятельности существует, фин
test "CATALOG-STATEMENTSONSPECIALBASIS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": going_concern_absent(entity_ref("urn:kz:catalog:statementsonspecialbasis:v0")) { origin case_input; }
    }
    evaluate truth(statements_on_special_basis(entity_ref("urn:kz:catalog:statementsonspecialbasis:v0")));
    expect truth_status == TRUE_ONLY;
}
