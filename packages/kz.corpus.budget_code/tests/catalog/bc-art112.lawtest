language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 112 пункт 2. Не допускается выставление инкассовых распоряжений на единый казначейский счёт и счета в иностранной валюте, открытые центральному уполномоч
test "CATALOG-NOCOLLECTIONORDERONTREASURYACCOUNT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": order_targets_treasury_account(entity_ref("urn:kz:catalog:nocollectionorderontreasuryaccount:v0")) { origin case_input; }
        assert "cat-1": order_issued_by(entity_ref("urn:kz:catalog:nocollectionorderontreasuryaccount:v0"), entity_ref("urn:kz:catalog:nocollectionorderontreasuryaccount:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(IssueCollectionOrderOnTreasuryAccount, ACTIVE);
}
