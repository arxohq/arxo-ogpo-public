language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 138 пункт 4. Не допускается принятие местными исполнительными органами обязательств по займам за третьих лиц в любом виде и любой форме
test "CATALOG-NOTHIRDPARTYLOANOBLIGATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": local_executive_body(entity_ref("urn:kz:catalog:nothirdpartyloanobligation:v1")) { origin case_input; }
        assert "cat-1": third_party_loan_obligation(entity_ref("urn:kz:catalog:nothirdpartyloanobligation:v0"), entity_ref("urn:kz:catalog:nothirdpartyloanobligation:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(AssumeThirdPartyLoanObligation, ACTIVE);
}
