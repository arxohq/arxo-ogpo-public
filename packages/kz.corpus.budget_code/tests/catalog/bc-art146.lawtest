language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 146. Привлечение внешних займов субъектами квазигосударственного сектора, не включёнными в перечень, предусмотренный подпунктом 2) настоящего пункта, не 
test "CATALOG-PART-NOEXTERNALBORROWINGOUTSIDELIST" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": quasi_in_question(entity_ref("urn:kz:catalog:noexternalborrowingoutsidelist:v0")) { origin case_input; }
        assert "cat-1": external_borrowing(entity_ref("urn:kz:catalog:noexternalborrowingoutsidelist:v0"), entity_ref("urn:kz:catalog:noexternalborrowingoutsidelist:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(BorrowExternallyOutsideList, ACTIVE);
}
