language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 82 пункт 5. Целевое назначение объёмов целевых трансфертов общего характера изменению не подлежит, за исключением случаев их перераспределения в пределах
test "CATALOG-TRANSFERPURPOSEUNCHANGEABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": purpose_change_sought(entity_ref("urn:kz:catalog:transferpurposeunchangeable:v0"), entity_ref("urn:kz:catalog:transferpurposeunchangeable:v1")) { origin case_input; }
    }
    evaluate truth(purpose_change_forbidden(entity_ref("urn:kz:catalog:transferpurposeunchangeable:v0")));
    expect truth_status == TRUE_ONLY;
}
