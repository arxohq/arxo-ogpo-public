language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 166 пункт 2 подпункт 1). Получатели связанных грантов обязаны своевременно исполнять принятые на себя обязательства, предусмотренные соглашением о связан
test "CATALOG-GRANTPERFORMOBLIGATIONSDUTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": grant_recipient(entity_ref("urn:kz:catalog:grantperformobligationsduty:v0"), entity_ref("urn:kz:catalog:grantperformobligationsduty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(PerformGrantObligations, ACTIVE);
}

// Статья 166 пункт 2 подпункт 2). Получатели связанных грантов обязаны обеспечить целевое и эффективное использование полученных связанных грантов
test "CATALOG-GRANTPURPOSEDUTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": grant_recipient(entity_ref("urn:kz:catalog:grantpurposeduty:v0"), entity_ref("urn:kz:catalog:grantpurposeduty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(UseGrantForPurpose, ACTIVE);
}

