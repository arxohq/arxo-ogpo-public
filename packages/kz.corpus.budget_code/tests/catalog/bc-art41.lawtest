language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 41. По основанию, названному настоящей статьёй, лицо несёт ответственность, установленную законами Республики Казахстан
test "CATALOG-LIABILITYONLISTEDGROUND" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": ground_listed_in_article_41(entity_ref("urn:kz:catalog:liabilityonlistedground:v0")) { origin case_input; }
        assert "cat-1": ground_established(entity_ref("urn:kz:catalog:liabilityonlistedground:v0"), entity_ref("urn:kz:catalog:liabilityonlistedground:v1")) { origin case_input; }
    }
    evaluate truth(liable_under_other_laws(entity_ref("urn:kz:catalog:liabilityonlistedground:v1"), entity_ref("urn:kz:catalog:liabilityonlistedground:v0")));
    expect truth_status == TRUE_ONLY;
}
