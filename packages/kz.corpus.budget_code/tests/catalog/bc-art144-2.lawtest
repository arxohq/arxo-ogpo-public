language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 144-2 пункт 1. Государственная гарантия по поддержке частного предпринимательства подлежит исполнению в случае недостаточности средств специального фонда
test "CATALOG-ENTREPRENEURSHIPGUARANTEEMUSTBEPERFORMED" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": entrepreneurship_guarantee(entity_ref("urn:kz:catalog:entrepreneurshipguaranteemustbeperformed:v0")) { origin case_input; }
        assert "cat-1": special_fund_insufficient(entity_ref("urn:kz:catalog:entrepreneurshipguaranteemustbeperformed:v0")) { origin case_input; }
    }
    evaluate truth(guarantee_must_be_performed(entity_ref("urn:kz:catalog:entrepreneurshipguaranteemustbeperformed:v0")));
    expect truth_status == TRUE_ONLY;
}
