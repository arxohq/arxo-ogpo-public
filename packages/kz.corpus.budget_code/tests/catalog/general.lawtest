language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 17-1 пункт 1 подпункт 3). При отчуждении акций системно значимого банка полученные средства подлежат перечислению в республиканский бюджет
// Посылки правила этой нормы порождающий сценарий не строит: мир без
// фактов фиксирует, что позиция НЕ возникает. Положительное
// свидетельство — долг (граница пакета).
test "CATALOG-NOPOS-TRANSFERDISPOSALPROCEEDS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect not position(TransferDisposalProceeds, ACTIVE);
}
