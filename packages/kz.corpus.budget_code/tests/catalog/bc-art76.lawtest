language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 76 пункт 2 абзац третий. Не допускаются взаимоотношения областных бюджетов с бюджетами городов районного значения, сёл, посёлков, сельских округов
test "CATALOG-NOREGIONALTORURALRELATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": budget_level(entity_ref("urn:kz:catalog:noregionaltoruralrelation:v0"), Regional) { origin case_input; }
        assert "cat-1": inter_budget_relation(entity_ref("urn:kz:catalog:noregionaltoruralrelation:v0"), entity_ref("urn:kz:catalog:noregionaltoruralrelation:v1")) { origin case_input; }
        assert "cat-2": budget_level(entity_ref("urn:kz:catalog:noregionaltoruralrelation:v1"), Rural) { origin case_input; }
    }
    evaluate truth(inter_budget_relation_forbidden(entity_ref("urn:kz:catalog:noregionaltoruralrelation:v0"), entity_ref("urn:kz:catalog:noregionaltoruralrelation:v1")));
    expect truth_status == TRUE_ONLY;
}

// Статья 76 пункт 4. Не допускается вмешательство Правительства и центральных государственных органов в бюджетный процесс нижестоящего уровня, за исключением случ
test "CATALOG-NOINTERFERENCEINLOWERBUDGETPROCESS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interference_in_budget_process(entity_ref("urn:kz:catalog:nointerferenceinlowerbudgetprocess:v0"), entity_ref("urn:kz:catalog:nointerferenceinlowerbudgetprocess:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(InterfereInBudgetProcess, ACTIVE);
}

// Статья 76 пункт 5. Не допускается изъятие доходов, дополнительно полученных в ходе исполнения местных бюджетов, в вышестоящий бюджет
test "CATALOG-NOWITHDRAWALOFADDITIONALLOCALREVENUE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": withdraws_additional_local_revenue(entity_ref("urn:kz:catalog:nowithdrawalofadditionallocalrevenue:v0"), entity_ref("urn:kz:catalog:nowithdrawalofadditionallocalrevenue:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(WithdrawAdditionalLocalRevenue, ACTIVE);
}
