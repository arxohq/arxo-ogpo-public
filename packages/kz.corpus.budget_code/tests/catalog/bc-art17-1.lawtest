language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 17-1 пункт 1. Правительство Республики Казахстан вправе участвовать в урегулировании системно значимых банков в соответствии с банковским законодательств
test "CATALOG-SYSTEMICBANKRESOLUTIONLIBERTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": government_of_kazakhstan(entity_ref("urn:kz:catalog:systemicbankresolutionliberty:v1")) { origin case_input; }
        assert "cat-1": systemic_bank_resolution(entity_ref("urn:kz:catalog:systemicbankresolutionliberty:v0"), entity_ref("urn:kz:catalog:systemicbankresolutionliberty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(ParticipateInBankResolution, ACTIVE);
}

// Статья 17-1 пункт 2. Не допускается отчуждение Правительством Республики Казахстан либо национальным управляющим холдингом акций системно значимого банка по сто
test "CATALOG-NODISPOSALBELOWACQUISITION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": disposal_below_acquisition(entity_ref("urn:kz:catalog:nodisposalbelowacquisition:v0")) { origin case_input; }
        assert "cat-1": systemic_bank_resolution(entity_ref("urn:kz:catalog:nodisposalbelowacquisition:v0"), entity_ref("urn:kz:catalog:nodisposalbelowacquisition:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(DisposeSharesBelowAcquisition, ACTIVE);
}
