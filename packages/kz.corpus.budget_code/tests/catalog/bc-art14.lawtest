language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 14. Не допускается введение новой бюджетной программы, направленной на достижение цели, уже закреплённой за другой бюджетной программой
test "CATALOG-NODUPLICATEPROGRAMME" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": programme_administrator(entity_ref("urn:kz:catalog:noduplicateprogramme:v0"), entity_ref("urn:kz:catalog:noduplicateprogramme:v2")) { origin case_input; }
        assert "cat-1": programme_targets_goal(entity_ref("urn:kz:catalog:noduplicateprogramme:v0"), entity_ref("urn:kz:catalog:noduplicateprogramme:v1")) { origin case_input; }
        assert "cat-2": programme_introduced_within_year(entity_ref("urn:kz:catalog:noduplicateprogramme:v0")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(IntroduceDuplicateProgramme, ACTIVE);
}
