language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 116 пункт 3. Изъятие остатка, изъятию не подлежащего, настоящим Кодексом не допускается
test "CATALOG-NOWITHDRAWALOFPROTECTEDBALANCE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": balance_not_withdrawable(entity_ref("urn:kz:catalog:nowithdrawalofprotectedbalance:v0")) { origin case_input; }
        assert "cat-1": withdrawal_to_upper_budget(entity_ref("urn:kz:catalog:nowithdrawalofprotectedbalance:v0"), entity_ref("urn:kz:catalog:nowithdrawalofprotectedbalance:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(WithdrawLocalBalance, ACTIVE);
}
