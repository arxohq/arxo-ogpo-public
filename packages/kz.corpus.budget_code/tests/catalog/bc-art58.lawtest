language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 58 пункт 5. Принятие правовых актов в целях финансирования мероприятий и проектов с условием возмещения затрат организациям нефтяного сектора запрещается
test "CATALOG-NOCOSTREIMBURSEMENTFOROILSECTOR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cost_reimbursement_act_intended(entity_ref("urn:kz:catalog:nocostreimbursementforoilsector:v0"), entity_ref("urn:kz:catalog:nocostreimbursementforoilsector:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(AdoptCostReimbursementAct, ACTIVE);
}
