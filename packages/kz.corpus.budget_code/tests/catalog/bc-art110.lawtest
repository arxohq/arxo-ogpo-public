language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 110 пункт 4. Не допускается проведение платежей и переводов денег государственных учреждений без зарегистрированной гражданско-правовой сделки по специфи
test "CATALOG-PART-NOPAYMENTWITHOUTREGISTEREDTRANSACTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": payment_by(entity_ref("urn:kz:catalog:nopaymentwithoutregisteredtransaction:v0"), entity_ref("urn:kz:catalog:nopaymentwithoutregisteredtransaction:v1")) { origin case_input; }
        assert "cat-1": registration_required_specific(entity_ref("urn:kz:catalog:nopaymentwithoutregisteredtransaction:v0")) { origin case_input; }
        assert "cat-2": payment_in_question(entity_ref("urn:kz:catalog:nopaymentwithoutregisteredtransaction:v0")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(MakeUnregisteredPayment, ACTIVE);
}
