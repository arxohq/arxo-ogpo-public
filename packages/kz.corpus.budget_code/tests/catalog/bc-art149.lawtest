language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 149 пункт 6. Не допускается разработка проектно-сметной документации по государственным инвестиционным проектам, не включённым в инвестиционный план
test "CATALOG-NODESIGNDOCSOUTSIDEINVESTMENTPLAN" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": not_in_investment_plan(entity_ref("urn:kz:catalog:nodesigndocsoutsideinvestmentplan:v0")) { origin case_input; }
        assert "cat-1": design_documentation_developed_by(entity_ref("urn:kz:catalog:nodesigndocsoutsideinvestmentplan:v0"), entity_ref("urn:kz:catalog:nodesigndocsoutsideinvestmentplan:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(DevelopDesignDocsOutsidePlan, ACTIVE);
}

// Статья 149 пункт 6. Не допускается разработка проектно-сметной документации по государственным инвестиционным проектам, не включённым в республиканский или мест
test "CATALOG-NODESIGNDOCSOUTSIDEBUDGET" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": not_in_budget(entity_ref("urn:kz:catalog:nodesigndocsoutsidebudget:v0")) { origin case_input; }
        assert "cat-1": design_documentation_developed_by(entity_ref("urn:kz:catalog:nodesigndocsoutsidebudget:v0"), entity_ref("urn:kz:catalog:nodesigndocsoutsidebudget:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(DevelopDesignDocsOutsideBudget, ACTIVE);
}
