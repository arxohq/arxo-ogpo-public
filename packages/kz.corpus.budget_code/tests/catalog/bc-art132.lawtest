language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 132 пункт 5. Периодичность промежуточной финансовой отчётности реже одного раза в год нижней границе настоящего Кодекса не отвечает
test "CATALOG-INTERIMREPORTINGPERIODUNLAWFUL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interim_reporting_period_set(entity_ref("urn:kz:catalog:interimreportingperiodunlawful:v0"), 13) { origin case_input; }
    }
    evaluate truth(interim_period_unlawful(entity_ref("urn:kz:catalog:interimreportingperiodunlawful:v0")));
    expect truth_status == TRUE_ONLY;
}

// Статья 132 пункт 5. Уполномоченный орган вправе определять сроки представления промежуточной финансовой отчётности и устанавливать иную периодичность, но не реж
test "CATALOG-INTERIMREPORTINGPERIODLAWFUL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interim_reporting_period_set(entity_ref("urn:kz:catalog:interimreportingperiodlawful:v0"), 12) { origin case_input; }
    }
    evaluate truth(interim_period_lawful(entity_ref("urn:kz:catalog:interimreportingperiodlawful:v0")));
    expect truth_status == TRUE_ONLY;
}
