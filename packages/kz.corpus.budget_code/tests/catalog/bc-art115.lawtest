language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 115 пункт 1. Возврат, произведённый не позднее последнего дня трёхмесячного срока, произведён в срок
test "CATALOG-MISUSEDFUNDSRETURNTIMELY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": returned_on(entity_ref("urn:kz:catalog:misusedfundsreturntimely:v0"), @2026-01-15) { origin case_input; }
        assert "cat-1": return_deadline(entity_ref("urn:kz:catalog:misusedfundsreturntimely:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(return_timely(entity_ref("urn:kz:catalog:misusedfundsreturntimely:v0")));
    expect truth_status == TRUE_ONLY;
}
