language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 83 пункт 5. Не допускается уменьшение объёмов целевых трансфертов на развитие в связи с дополнительно полученными нижестоящими бюджетами доходами
test "CATALOG-NODEVELOPMENTTRANSFERREDUCTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": development_targeted_transfer(entity_ref("urn:kz:catalog:nodevelopmenttransferreduction:v0")) { origin case_input; }
        assert "cat-1": reduction_due_to_additional_revenue(entity_ref("urn:kz:catalog:nodevelopmenttransferreduction:v0"), entity_ref("urn:kz:catalog:nodevelopmenttransferreduction:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(ReduceDevelopmentTransfer, ACTIVE);
}

// Статья 83 пункт 6. Целевые трансферты используются местными исполнительными органами только в соответствии с их целевым назначением
test "CATALOG-TARGETEDTRANSFERPURPOSEDUTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": transfer_received_by(entity_ref("urn:kz:catalog:targetedtransferpurposeduty:v0"), entity_ref("urn:kz:catalog:targetedtransferpurposeduty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(UseTransferForDesignatedPurpose, ACTIVE);
}
