language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 5 пункт 4. Получатели бюджетных средств обязаны расходовать бюджетные средства по целевому назначению
test "CATALOG-SPENDFORDESIGNATEDPURPOSEDUTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": received_budget_funds(entity_ref("urn:kz:catalog:spendfordesignatedpurposeduty:v0"), entity_ref("urn:kz:catalog:spendfordesignatedpurposeduty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(SpendForDesignatedPurpose, ACTIVE);
}

// Статья 5 пункт 4. Получателям бюджетных средств запрещается размещать бюджетные средства на депозитах и в иных финансовых инструментах ради получения вознагражд
test "CATALOG-NODEPOSITPLACEMENTOFBUDGETFUNDS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": received_budget_funds(entity_ref("urn:kz:catalog:nodepositplacementofbudgetfunds:v0"), entity_ref("urn:kz:catalog:nodepositplacementofbudgetfunds:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(PlaceBudgetFundsOnDeposit, ACTIVE);
}
