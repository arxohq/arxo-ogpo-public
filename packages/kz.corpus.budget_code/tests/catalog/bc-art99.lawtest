language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 99 пункт 2. Введение чрезвычайного положения на территории нескольких регионов может являться основанием для введения чрезвычайного государственного бюдж
test "CATALOG-EMERGENCYBUDGETGROUND" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": consequences_threaten_stability(entity_ref("urn:kz:catalog:emergencybudgetground:v0")) { origin case_input; }
        assert "cat-1": emergency_declared_in_several_regions(entity_ref("urn:kz:catalog:emergencybudgetground:v0")) { origin case_input; }
    }
    evaluate truth(emergency_budget_ground(entity_ref("urn:kz:catalog:emergencybudgetground:v0")));
    expect truth_status == TRUE_ONLY;
}
