language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 118 пункт 5. Участники бюджетного процесса обязаны руководствоваться нормативными правовыми актами по составлению и представлению бюджетной отчётности
test "CATALOG-BUDGETREPORTREGULATIONDUTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": prepares_budget_report(entity_ref("urn:kz:catalog:budgetreportregulationduty:v0"), entity_ref("urn:kz:catalog:budgetreportregulationduty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(FollowReportingRegulations, ACTIVE);
}
