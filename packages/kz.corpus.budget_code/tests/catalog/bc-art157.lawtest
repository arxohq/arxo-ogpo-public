language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 157. В случае использования бюджетного кредита по нецелевому назначению заёмщик и конечный заёмщик несут ответственность в соответствии с законами Респуб
test "CATALOG-LIABILITYFORCREDITMISUSE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": credit_misused(entity_ref("urn:kz:catalog:liabilityforcreditmisuse:v0"), entity_ref("urn:kz:catalog:liabilityforcreditmisuse:v1")) { origin case_input; }
    }
    evaluate truth(borrower_liable(entity_ref("urn:kz:catalog:liabilityforcreditmisuse:v1"), entity_ref("urn:kz:catalog:liabilityforcreditmisuse:v0")));
    expect truth_status == TRUE_ONLY;
}
