language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 98 пункт 2 подпункт 2) абзац четвёртый. Не допускается перераспределение средств, направленных на использование займов и грантов
test "CATALOG-NOREDISTRIBUTIONOFLOANORGRANTFUNDS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": loan_or_grant_funded(entity_ref("urn:kz:catalog:noredistributionofloanorgrantfunds:v0")) { origin case_input; }
        assert "cat-1": programme_administrator(entity_ref("urn:kz:catalog:noredistributionofloanorgrantfunds:v0"), entity_ref("urn:kz:catalog:noredistributionofloanorgrantfunds:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(RedistributeLoanOrGrantFunds, ACTIVE);
}
