language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 117 пункт 5. Бюджетная отчётность должна соответствовать качественным характеристикам понятности, уместности, достоверности и сопоставимости
test "CATALOG-REPORTQUALITYMET" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": report_reliable(entity_ref("urn:kz:catalog:reportqualitymet:v0")) { origin case_input; }
        assert "cat-1": report_relevant(entity_ref("urn:kz:catalog:reportqualitymet:v0")) { origin case_input; }
        assert "cat-2": report_understandable(entity_ref("urn:kz:catalog:reportqualitymet:v0")) { origin case_input; }
        assert "cat-3": report_comparable(entity_ref("urn:kz:catalog:reportqualitymet:v0")) { origin case_input; }
    }
    evaluate truth(report_quality_met(entity_ref("urn:kz:catalog:reportqualitymet:v0")));
    expect truth_status == TRUE_ONLY;
}
