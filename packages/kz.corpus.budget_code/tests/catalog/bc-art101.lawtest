language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 101 пункт 7. Не допускается перевод остатков бюджетных средств по бюджетным программам, образовавшихся на 31 декабря текущего финансового года, на аккред
test "CATALOG-NOBALANCETRANSFERTOOFFBUDGETACCOUNTS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": transfer_of_balances_to_offbudget_account(entity_ref("urn:kz:catalog:nobalancetransfertooffbudgetaccounts:v0"), entity_ref("urn:kz:catalog:nobalancetransfertooffbudgetaccounts:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(TransferBalancesOffBudget, ACTIVE);
}

// Статья 101 пункт 8. При исполнении бюджета использование в текущем финансовом году бюджетных средств, предусмотренных во втором и (или) третьем финансовых годах
test "CATALOG-NOUSEOFFUTUREYEARAPPROPRIATIONS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": uses_future_year_appropriation(entity_ref("urn:kz:catalog:nouseoffutureyearappropriations:v0"), entity_ref("urn:kz:catalog:nouseoffutureyearappropriations:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(UseFutureYearAppropriation, ACTIVE);
}
