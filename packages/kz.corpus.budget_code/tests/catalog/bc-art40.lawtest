language "law.core" version "0.1";
package kz.corpus.budget_code version "0.1.0";
namespace "urn:kz:corpus:clir:budget-code";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// Статья 40. Документ, публикация которого отнесена к участнику, подлежит публикации
test "CATALOG-PUBLICATIONOWEDPROJECTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": publication_required(entity_ref("urn:kz:catalog:publicationowedprojection:v0"), entity_ref("urn:kz:catalog:publicationowedprojection:v1")) { origin case_input; }
    }
    evaluate truth(publication_owed(entity_ref("urn:kz:catalog:publicationowedprojection:v0")));
    expect truth_status == TRUE_ONLY;
}

// Статья 40. Участник бюджетного процесса обеспечивает публикацию отнесённых к нему документов бюджетного процесса
test "CATALOG-PUBLICATIONDUTY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": publication_required(entity_ref("urn:kz:catalog:publicationduty:v0"), entity_ref("urn:kz:catalog:publicationduty:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(PublishProcessDocument, ACTIVE);
}
