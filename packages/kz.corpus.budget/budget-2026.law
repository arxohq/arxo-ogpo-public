// Закон Республики Казахстан от 8 декабря 2025 года № 239-VIII ЗРК
// «О республиканском бюджете на 2026 – 2028 годы».
//
// Четвёртый акт корпуса: ПАРАМЕТРЫ ГОДА как нормативные факты. Их читают
// исполнением этого пакета остальные формализации — ставки госпошлин в МРП
// (kz.corpus.incometax), пороги способов закупок (kz.corpus.procurement,
// kz.corpus.healthprocurement), объект исчисления взносов ОСМС
// (kz.corpus.osms), черта для АСП (kz.corpus.socialassistance).
// key(year) §45.1: один параметр на год — дубль даёт KEY_CONFLICT.
//
// ЗАКРЕПЛЁН 27.08.2026 — до этого акт был учебным заместителем
// (ABSTRACT_ONLY), и это оказалось не формальностью. Закрепление байтов
// исправило три вещи, каждая из которых меняла ответы потребителей:
//
//   - МРП: было 3 932 ₸ (величина 2025 года), в законе — **4 325 ₸**;
//   - прожиточный минимум: было 46 228 ₸, в законе — **50 851 ₸**;
//   - статья: параметры стоят в СТАТЬЕ 7, а якорь и локатор указывали на
//     статью 8 — там про индексацию пенсионных выплат.
//
// Минимальный размер заработной платы (85 000 ₸) совпал. Одно совпадение из
// четырёх — цена доверия к пересказу вместо сверки с текстом.
//
// Границы: приложения к закону (объёмы поступлений и расходов, 196 КБ
// таблиц) фрагментами не закрепляются — это данные, а не статьи, и адресовать
// их придётся собственными локаторами, когда появится потребитель. Статья 35
// поэтому обрывается на подписи Президента: наивная граница «до следующей
// статьи» утянула бы в неё весь хвост закона.

language "law.core" version "0.2";
package kz.corpus.budget version "0.1.0";
namespace "urn:kz:corpus:clir:budget";

// Понятия показателей определяет Бюджетный кодекс (ст. 86 п. 4:
// текст закона о бюджете обязан их содержать), значения на год — этот
// закон. Пилот DECISION-0112: отношение одно, значение своё.
import kz.corpus.budget_code version "0.1.0";

// Показатель Бюджетного кодекса (ст. 86 п. 4): значение этого закона
// доступно и под прежним именем — читатели, ещё не перешедшие на
// кодекс, работают без правки (миграция по касанию, DECISION-0107).
pub relation mrp(year: Integer, amount: Money) kind institutional {
    key(year);
    label ru-KZ official "месячный расчётный показатель";
}

@source("urn:kz:corpus:clir:budget-code#BC_ART86")
rule MrpFromBudgetCode(amount: Money) strict {
    label ru-KZ official "месячный расчётный показатель — показатель, названный статьёй 86 Бюджетного кодекса на 2026 год";
    when kz.corpus.budget_code::mrp(2026, amount);
    then mrp(2026, amount);
}
// Показатель Бюджетного кодекса (ст. 86 п. 4): значение этого закона
// доступно и под прежним именем — читатели, ещё не перешедшие на
// кодекс, работают без правки (миграция по касанию, DECISION-0107).
pub relation minimum_wage(year: Integer, amount: Money) kind institutional {
    key(year);
    label ru-KZ official "минимальный размер заработной платы";
}

@source("urn:kz:corpus:clir:budget-code#BC_ART86")
rule MinimumWageFromBudgetCode(amount: Money) strict {
    label ru-KZ official "минимальный размер заработной платы — показатель, названный статьёй 86 Бюджетного кодекса на 2026 год";
    when kz.corpus.budget_code::minimum_wage(2026, amount);
    then minimum_wage(2026, amount);
}
// Показатель Бюджетного кодекса (ст. 86 п. 4): значение этого закона
// доступно и под прежним именем — читатели, ещё не перешедшие на
// кодекс, работают без правки (миграция по касанию, DECISION-0107).
pub relation subsistence_minimum(year: Integer, amount: Money) kind institutional {
    key(year);
    label ru-KZ official "величина прожиточного минимума";
}

@source("urn:kz:corpus:clir:budget-code#BC_ART86")
rule SubsistenceMinimumFromBudgetCode(amount: Money) strict {
    label ru-KZ official "величина прожиточного минимума — показатель, названный статьёй 86 Бюджетного кодекса на 2026 год";
    when kz.corpus.budget_code::subsistence_minimum(2026, amount);
    then subsistence_minimum(2026, amount);
}
// Показатель Бюджетного кодекса (ст. 86 п. 4): значение этого закона
// доступно и под прежним именем — читатели, ещё не перешедшие на
// кодекс, работают без правки (миграция по касанию, DECISION-0107).
pub relation base_pension(year: Integer, amount: Money) kind institutional {
    key(year);
    label ru-KZ official "минимальный размер государственной базовой пенсионной выплаты";
}

@source("urn:kz:corpus:clir:budget-code#BC_ART86")
rule BasePensionFromBudgetCode(amount: Money) strict {
    label ru-KZ official "минимальный размер государственной базовой пенсионной выплаты — показатель, названный статьёй 86 Бюджетного кодекса на 2026 год";
    when kz.corpus.budget_code::base_pension(2026, amount);
    then base_pension(2026, amount);
}
// Показатель Бюджетного кодекса (ст. 86 п. 4): значение этого закона
// доступно и под прежним именем — читатели, ещё не перешедшие на
// кодекс, работают без правки (миграция по касанию, DECISION-0107).
pub relation minimum_pension(year: Integer, amount: Money) kind institutional {
    key(year);
    label ru-KZ official "минимальный размер пенсии";
}

@source("urn:kz:corpus:clir:budget-code#BC_ART86")
rule MinimumPensionFromBudgetCode(amount: Money) strict {
    label ru-KZ official "минимальный размер пенсии — показатель, названный статьёй 86 Бюджетного кодекса на 2026 год";
    when kz.corpus.budget_code::minimum_pension(2026, amount);
    then minimum_pension(2026, amount);
}
// Показатель Бюджетного кодекса (ст. 86 п. 4): значение этого закона
// доступно и под прежним именем — читатели, ещё не перешедшие на
// кодекс, работают без правки (миграция по касанию, DECISION-0107).
pub relation state_osms_rate(year: Integer, rate: Decimal) kind institutional {
    key(year);
    label ru-KZ official "размер взносов государства на обязательное социальное медицинское страхование";
}

@source("urn:kz:corpus:clir:budget-code#BC_ART86")
rule StateOsmsRateFromBudgetCode(rate: Decimal) strict {
    label ru-KZ official "размер взносов государства на обязательное социальное медицинское страхование — показатель, названный статьёй 86 Бюджетного кодекса на 2026 год";
    when kz.corpus.budget_code::state_osms_rate(2026, rate);
    then state_osms_rate(2026, rate);
}

// --- Ст. 7: параметры, устанавливаемые с 1 января 2026 года -----------------

@source(BUDGET_ART7)
assert kz.corpus.budget_code::minimum_wage(2026, 85000 KZT);

@source(BUDGET_ART7)
assert kz.corpus.budget_code::base_pension(2026, 35596 KZT);

@source(BUDGET_ART7)
assert kz.corpus.budget_code::minimum_pension(2026, 69049 KZT);

@source(BUDGET_ART7)
assert kz.corpus.budget_code::mrp(2026, 4325 KZT);

@source(BUDGET_ART7)
assert kz.corpus.budget_code::subsistence_minimum(2026, 50851 KZT);

// --- Ст. 9: ставка взносов государства на ОСМС ------------------------------
// Величина, которую Закон об ОСМС (405-V) сам не устанавливает: ст. 26 п. 2
// отсылает её к закону о республиканском бюджете. Здесь она получает
// источник, а не остаётся константой в потребителе.

@source(BUDGET_ART9)
assert kz.corpus.budget_code::state_osms_rate(2026, 2 percent);

source BUDGET_LAW {
    kind law;
    jurisdiction KZ;
    number "239-VIII";
    label ru-KZ official "О республиканском бюджете на 2026 – 2028 годы";
}

edition BUDGET_EDITION of BUDGET_LAW {
    label ru-KZ official "Закон о республиканском бюджете на 2026–2028 годы, редакция от 8 декабря 2025 года";
    language ru-KZ;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @2025-12-08;
    // Ст. 34: «Настоящий Закон вводится в действие с 1 января 2026 года».
    in_force @2026-01-01;
}

// §27.3: закреплённые байты редакции. Портал отдаёт ТЕКУЩУЮ консолидированную
// редакцию — `retrieved_at` фиксирует момент, `content_hash` делает копию
