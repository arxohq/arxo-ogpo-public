fragment BUDGET_ART10 in BUDGET_EDITION {
    kind article;
    locator "article/10";
    text ru-KZ official """Статья 10. Установить с 1 января 2026 года месячный размер денежной компенсации на содержание жилища и оплату коммунальных услуг в сумме 3 739 тенге военнослужащим (кроме военнослужащих срочной службы) и сотрудникам специальных государственных и правоохранительных органов, государственной фельдъегерской службы.""";
