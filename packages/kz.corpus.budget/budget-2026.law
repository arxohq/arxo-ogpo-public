fragment BUDGET_ART31 in BUDGET_EDITION {
    kind article;
    locator "article/31";
    text ru-KZ official """Статья 31. Утвердить перечень республиканских бюджетных программ (подпрограмм), не подлежащих секвестру в процессе исполнения республиканского бюджета на 2026 год, согласно приложению 5 к настоящему Закону.
Установить, что в процессе исполнения местных бюджетов на 2026 год не подлежат секвестру местные бюджетные программы согласно приложению 6 к настоящему Закону.""";
    content_hash "sha256:d3d0ea566abe08462b81e348a1911f465251109cdf5fec98d20a0dd28000e9fc";
}

