test "ставка взносов государства на ОСМС 2026 года — 2 процента (статья 9)" {
    given {
        context {
            decision_time @2026-09-13T12:00:00+05:00;
            knowledge_time @2026-09-13T12:00:00+05:00;
            legal_time @2026-09-13;
            timezone "Asia/Almaty";
        }
    }
    evaluate truth(state_osms_rate(2026, 2 percent));
    expect truth_status == TRUE_ONLY;
}

// Отрицательная граница: закон 2026 года не говорит о параметрах 2025 года —
// ключ `year` (§45.1) держит их раздельно, forwarding-правило анкеровано
// только на 2026-й.
test "закон 2026 года не говорит о параметрах 2025 года" {
    given {
        context {
            decision_time @2026-09-13T12:00:00+05:00;
            knowledge_time @2026-09-13T12:00:00+05:00;
            legal_time @2026-09-13;
            timezone "Asia/Almaty";
        }
    }
    evaluate truth(mrp(2025, 3932 KZT));
    expect truth_status == NEITHER;
}
