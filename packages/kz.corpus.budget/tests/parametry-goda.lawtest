test "прожиточный минимум 2026 года — 50 851 тенге (статья 7)" {
    given {
        context {
            decision_time @2026-09-13T12:00:00+05:00;
            knowledge_time @2026-09-13T12:00:00+05:00;
            legal_time @2026-09-13;
            timezone "Asia/Almaty";
        }
    }
    evaluate truth(subsistence_minimum(2026, 50851 KZT));
    expect truth_status == TRUE_ONLY;
