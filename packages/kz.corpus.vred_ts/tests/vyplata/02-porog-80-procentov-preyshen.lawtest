language "law.core" version "0.1";
package kz.corpus.vred_ts version "0.1.0";
namespace "urn:kz:corpus:clir:vred-ts";

// Cl. 9. Upper edge of the threshold: expenses exceeding eighty percent of
// the market value by even one tenge make restoration economically
// inexpedient.
test "urn:query:vred-t02" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "vred-t02-a0": ozhidaemye_raskhody_na_vosstanovlenie(v: entity_ref("urn:case:vred:ts-1"), amount: 800001 KZT) { origin case_input; }
        assert "vred-t02-a1": rynochnaya_stoimost_na_datu_otcheta(v: entity_ref("urn:case:vred:ts-1"), amount: 1000000 KZT) { origin case_input; }
    }

    evaluate truth(vosstanovlenie_ekonomicheski_netselesoobrazno(entity_ref("urn:case:vred:ts-1")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
