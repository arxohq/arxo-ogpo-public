language "law.core" version "0.1";
package kz.corpus.vred_ts version "0.1.0";
namespace "urn:kz:corpus:clir:vred-ts";

// Cl. 4-1. Upper edge of the threshold: one appraiser — there is no
// choice, and this is an established negation, not silence: the defeasible
// rule of cl. 4-1 derives a negative head.
test "urn:query:vred-t08" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "vred-t08-a0": predlozheno_otsenshchikov(r: entity_ref("urn:case:vred:raschet-1"), n: 1) { origin case_input; }
    }

    evaluate truth(vybor_otsenshchikov_obespechen(entity_ref("urn:case:vred:raschet-1")));

    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
