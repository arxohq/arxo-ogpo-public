            origin case_input;
        }

        assert "assert-f3": otchet_poluchen_poterpevshim(r: entity_ref("urn:kz:vred:raschet-1"), day: @2026-09-01) {
            origin case_input;
        }

        assert "assert-f4": otmetka_o_soglasii_prostavlena(entity_ref("urn:kz:vred:raschet-1")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(ProstavitOtmetku, SATISFIED);
    expect not position(ProstavitOtmetku, CREATED);
    expect not position(ProstavitOtmetku, PENDING);
    expect not position(ProstavitOtmetku, ACTIVE);
    expect not position(ProstavitOtmetku, VIOLATED);
    expect not position(ProstavitOtmetku, WAIVED);
    expect not position(ProstavitOtmetku, SUSPENDED);
    expect not position(ProstavitOtmetku, TERMINATED);
    expect not position(ProstavitOtmetku, EXPIRED);
    expect not position(ProstavitOtmetku, UNDETERMINED);
    expect not position(ProstavitOtmetku, AVAILABLE);
    expect not position(ProstavitOtmetku, EXERCISED);
    expect not position(ProstavitOtmetku, VALIDLY_EXERCISED);
    expect not position(ProstavitOtmetku, INVALIDLY_EXERCISED);
    expect not position(ProstavitOtmetku, CONFLICTED);
    expect not position(ProstavitOtmetku, DEFEATED);
}

test "KZ-VRED-14-OTMETKA-PROSROCHENA" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-10-01T12:00:00+05:00;
            knowledge_time @2026-10-01T12:00:00+05:00;
