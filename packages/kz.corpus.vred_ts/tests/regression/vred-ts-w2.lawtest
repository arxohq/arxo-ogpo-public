            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }

        assert "assert-f0": raschet_po_ts(r: entity_ref("urn:kz:vred:raschet-1"), v: entity_ref("urn:kz:vred:ts-1")) {
            origin case_input;
        }

