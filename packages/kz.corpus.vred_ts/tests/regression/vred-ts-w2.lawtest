language "law.core" version "0.1";
package kz.corpus.vred_ts version "0.1.0";
namespace "urn:kz:corpus:clir:vred-ts";

// Scenarios ported from the former Python runner of the `vred_ts` family.
// Titles are the former scenario IDs (scenario-manifest); expectations are
// derived from the FORMER checks, not from the engine's answers.
// For duty witnesses, decision and knowledge follow the September events (§82).

context profile KZ_VRED_TS_DEADLINES {
    deadline_policy {
            start_count next_day;
            include_end true;
            roll next_working_day;
        }
}

test "KZ-VRED-13-OTMETKA-V-SROK" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }

        assert "assert-f0": raschet_po_ts(r: entity_ref("urn:kz:vred:raschet-1"), v: entity_ref("urn:kz:vred:ts-1")) {
            origin case_input;
        }

        assert "assert-f1": strakhovshchik_po_raschetu(r: entity_ref("urn:kz:vred:raschet-1"), s: entity_ref("urn:kz:vred:strakhovshchik-1")) {
            origin case_input;
        }

        assert "assert-f2": poterpevshiy_po_raschetu(r: entity_ref("urn:kz:vred:raschet-1"), p: entity_ref("urn:kz:vred:poterpevshiy-1")) {
            origin case_input;
        }

        assert "assert-f3": otchet_poluchen_poterpevshim(r: entity_ref("urn:kz:vred:raschet-1"), day: @2026-09-01) {
            origin case_input;
        }
    }

    evaluate truth(predel_otmetki_poterpevshego(r: entity_ref("urn:kz:vred:raschet-1"), day: @2026-09-04));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}

test "KZ-VRED-13-OTMETKA-V-SROK/2" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-10-01T12:00:00+05:00;
            knowledge_time @2026-10-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }

        assert "assert-f0": raschet_po_ts(r: entity_ref("urn:kz:vred:raschet-1"), v: entity_ref("urn:kz:vred:ts-1")) {
            origin case_input;
        }

        assert "assert-f1": strakhovshchik_po_raschetu(r: entity_ref("urn:kz:vred:raschet-1"), s: entity_ref("urn:kz:vred:strakhovshchik-1")) {
            origin case_input;
        }

