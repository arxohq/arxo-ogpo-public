    expect not position(PeredatZamenyaemuyuDetal, EXERCISED);
    expect not position(PeredatZamenyaemuyuDetal, VALIDLY_EXERCISED);
    expect not position(PeredatZamenyaemuyuDetal, INVALIDLY_EXERCISED);
