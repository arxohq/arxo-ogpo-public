    evaluate positions();
    expect issues_within(info);
    expect position(ObespechitRaschetIznosaOmbudsmanom, SATISFIED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, CREATED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, PENDING);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, ACTIVE);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, VIOLATED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, WAIVED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, SUSPENDED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, TERMINATED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, EXPIRED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, UNDETERMINED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, AVAILABLE);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, EXERCISED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, VALIDLY_EXERCISED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, INVALIDLY_EXERCISED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, CONFLICTED);
    expect not position(ObespechitRaschetIznosaOmbudsmanom, DEFEATED);
}
