language "law.core" version "0.2";
package kz.corpus.vred_ts version "0.1.0";
namespace "urn:kz:corpus:clir:vred-ts";

// Cl. 10: "was not previously damaged AND was not repaired" — two
// conditions. An intact but repaired part does not satisfy the condition.

// Both conditions are satisfied (via the sub-facts) — no wear.
test "urn:query:vred-t12-a" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t12a-a0": detal_ts(d: entity_ref("urn:case:vred:detal-1"), v: entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12a-a1": detal_podlezhit_zamene(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12a-a2": vladelets_fizicheskoe_litso(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12a-a3": ne_podlezhit_obyazatelnomu_tekhosmotru(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12a-a4": detal_ranee_ne_povrezhdalas(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12a-a5": detal_ne_podvergalas_remontu(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12a-a6": srednegodovoy_probeg(v: entity_ref("urn:case:vred:ts-1"), distance: 12000 km) { origin case_input; }
    }
    evaluate truth(detal_otsenivaetsya_bez_iznosa(entity_ref("urn:case:vred:detal-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(DetalNePovrezhdalasINeRemontirovalas);
}

// The part was not damaged but was repaired — the condition is not satisfied.
test "urn:query:vred-t12-b" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t12b-a0": detal_ts(d: entity_ref("urn:case:vred:detal-1"), v: entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12b-a1": detal_podlezhit_zamene(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12b-a2": vladelets_fizicheskoe_litso(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12b-a3": ne_podlezhit_obyazatelnomu_tekhosmotru(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12b-a4": detal_ranee_ne_povrezhdalas(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12b-a6": srednegodovoy_probeg(v: entity_ref("urn:case:vred:ts-1"), distance: 12000 km) { origin case_input; }
    }
    evaluate truth(detal_otsenivaetsya_bez_iznosa(entity_ref("urn:case:vred:detal-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

