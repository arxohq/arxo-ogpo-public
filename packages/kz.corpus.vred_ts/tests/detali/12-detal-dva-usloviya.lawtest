// A natural person with 18,000 km mileage: the natural person's threshold
// (15,000) is exceeded, and the legal entity's threshold (20,000) does not apply to a natural person.
test "urn:query:vred-t12-d" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t12d-a0": detal_ts(d: entity_ref("urn:case:vred:detal-1"), v: entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12d-a1": detal_podlezhit_zamene(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12d-a2": vladelets_fizicheskoe_litso(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12d-a3": ne_podlezhit_obyazatelnomu_tekhosmotru(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12d-a7": nakhoditsya_na_garantiynom_obsluzhivanii(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t12d-a4": detal_ranee_ne_povrezhdalas(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12d-a5": detal_ne_podvergalas_remontu(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t12d-a6": srednegodovoy_probeg(v: entity_ref("urn:case:vred:ts-1"), distance: 18000 km) { origin case_input; }
    }
    evaluate truth(detal_otsenivaetsya_bez_iznosa(entity_ref("urn:case:vred:detal-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

