language "law.core" version "0.1";
package kz.corpus.vred_ts version "0.1.0";
namespace "urn:kz:corpus:clir:vred-ts";

// Boundaries of the cl. 3 deadlines on the 2026 calendar. Dates were
// computed BY HAND from the pinned snapshot (weekends — Saturday and Sunday;
// holidays and shifted days off — per the snapshot's list): a deadline of N
// business days expires on the N-th business day after the day of the event
// (Civil Code of the RoK art. 173, 176).

context profile KZ_VRED_TS_DEADLINES {
    deadline_policy {
            start_count next_day;
            include_end true;
            roll next_working_day;
        }
}

// The report was received on Friday, March 6, 2026. Then: Sat 7, Sun 8
// (holiday), Mon 9 (shifted day off) — not counted; Tue 10 (1), Wed 11 (2),
// Thu 12 (3). The endorsement deadline is March 12.
test "urn:query:vred-t14-a" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-03-06T12:00:00+05:00;
            knowledge_time @2026-03-06T12:00:00+05:00;
            legal_time @2026-03-06;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }
        assert "t14a-a0": otchet_poluchen_poterpevshim(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-03-06) { origin case_input; }
    }
    evaluate truth(predel_otmetki_poterpevshego(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-03-12));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;

    evaluate truth(predel_otmetki_poterpevshego(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-03-11));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Inspection on Thursday, March 19, 2026, spanning Nauryz: Fri 20 (1);
// Sat 21, Sun 22, Mon 23 (holidays), Tue 24, Wed 25 (shifted days off) —
// not counted; Thu 26 (2), Fri 27 (3); Sat 28, Sun 29 — no; Mon 30 (4),
// Tue 31 (5). The report submission deadline is March 31.
test "urn:query:vred-t14-b" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-03-19T12:00:00+05:00;
            knowledge_time @2026-03-19T12:00:00+05:00;
            legal_time @2026-03-19;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }
        assert "t14b-a0": osmotr_osushchestvlen_strakhovshchikom(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-03-19) { origin case_input; }
    }
    evaluate truth(predel_predostavleniya_otcheta(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-03-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// The insurer's endorsement of disagreement was received on Wednesday,
// April 15, 2026 — an ordinary week: Thu 16 (1), Fri 17 (2), Mon 20 (3).
// The response deadline is April 20.
test "urn:query:vred-t14-c" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-04-15T12:00:00+05:00;
            knowledge_time @2026-04-15T12:00:00+05:00;
            legal_time @2026-04-15;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }
        assert "t14c-a0": otmetka_nesoglasiya_poluchena_strakhovshchikom(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-04-15) { origin case_input; }
    }
    evaluate truth(predel_otveta_strakhovshchika(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-04-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// The report is not provided at all: inspection on September 1, deadline
// September 8. Check day September 8 — the deadline has not yet been
// missed; September 9 — it is missed.
test "urn:query:vred-t14-d" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-09-08T12:00:00+05:00;
            knowledge_time @2026-09-08T12:00:00+05:00;
            legal_time @2026-09-08;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }
        assert "t14d-a0": poterpevshiy_po_raschetu(r: entity_ref("urn:case:vred:raschet-1"), p: entity_ref("urn:case:vred:poterpevshiy-1")) { origin case_input; }
        assert "t14d-a1": osmotr_osushchestvlen_strakhovshchikom(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-09-01) { origin case_input; }
        assert "t14d-a2": not otchet_predostavlen_poterpevshemu(entity_ref("urn:case:vred:raschet-1")) { origin case_input; }
        assert "t14d-a3": den_rassmotreniya_dela(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-09-08) { origin case_input; }
        assert "t14d-a4": poterpevshiy_po_raschetu(r: entity_ref("urn:case:vred:raschet-2"), p: entity_ref("urn:case:vred:poterpevshiy-2")) { origin case_input; }
        assert "t14d-a5": osmotr_osushchestvlen_strakhovshchikom(r: entity_ref("urn:case:vred:raschet-2"), day: @2026-09-01) { origin case_input; }
        assert "t14d-a6": not otchet_predostavlen_poterpevshemu(entity_ref("urn:case:vred:raschet-2")) { origin case_input; }
        assert "t14d-a7": den_rassmotreniya_dela(r: entity_ref("urn:case:vred:raschet-2"), day: @2026-09-09) { origin case_input; }
    }
    evaluate truth(pravo_na_vyplatu_po_punktu_3_1_stati_22_zakona(p: entity_ref("urn:case:vred:poterpevshiy-1"), r: entity_ref("urn:case:vred:raschet-1")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;

    evaluate truth(pravo_na_vyplatu_po_punktu_3_1_stati_22_zakona(p: entity_ref("urn:case:vred:poterpevshiy-2"), r: entity_ref("urn:case:vred:raschet-2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Policy §86 is not set — the deadline is not computed, and the result
// status names the reason (E-0105): MISSING_POLICY, not the law being silent.
test "urn:query:vred-t14-e" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }
        assert "t14e-a0": otchet_poluchen_poterpevshim(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-09-01) { origin case_input; }
    }
    evaluate truth(predel_otmetki_poterpevshego(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-09-04));
    expect truth_status == NEITHER;
    expect evaluation_status == MISSING_POLICY;
}

// The report was received on Wednesday, December 30, 2026: the third
// business day already falls in 2027, outside the snapshot's coverage —
// the deadline is not computed, and the document carries the
// CALENDAR_OUT_OF_RANGE code (§85.1). The §175 result status is
// deliberately NOT checked here: the E-0105 list assigns to MISSING_INPUT
// only MISSING_CALENDAR and CALENDAR_DATASET_INVALID ("other codes —
// RUNTIME_ERROR"), and both implementations answer MISSING_INPUT byte-for-
// byte identically — an open qualification, SPEC-1 in tools/catala/REPORT.md,
// awaiting the owner's errata.
test "urn:query:vred-t14-g" {
    given {
        context extends KZ_VRED_TS_DEADLINES {
            decision_time @2026-12-30T12:00:00+05:00;
            knowledge_time @2026-12-30T12:00:00+05:00;
            legal_time @2026-12-30;
            timezone "Asia/Qyzylorda";
            calendar "urn:kz:corpus:clir:official-calendar#snapshot-2026";
        }
        assert "t14g-a0": otchet_poluchen_poterpevshim(r: entity_ref("urn:case:vred:raschet-1"), day: @2026-12-30) { origin case_input; }
    }
    evaluate truth(predel_otmetki_poterpevshego(r: entity_ref("urn:case:vred:raschet-1"), day: @2027-01-05));
    expect truth_status == NEITHER;
    expect issue(CALENDAR_OUT_OF_RANGE);
}
