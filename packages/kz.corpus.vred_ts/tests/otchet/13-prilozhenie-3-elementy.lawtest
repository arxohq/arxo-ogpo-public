// All four calculation particulars and all three appendices — both groups are derived.
test "urn:query:vred-t13-e" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t13e-a0": otchet_stoimost_detaley(entity_ref("urn:case:vred:otchet-1"), 100000 KZT) { origin case_input; }
        assert "t13e-a1-0": otchet_obemy_rabot(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13e-a1-1": otchet_stoimost_rabot(entity_ref("urn:case:vred:otchet-1"), 100000 KZT) { origin case_input; }
        assert "t13e-a2": otchet_stoimost_materialov(entity_ref("urn:case:vred:otchet-1"), 100000 KZT) { origin case_input; }
        assert "t13e-a3": otchet_stoimost_remonta(entity_ref("urn:case:vred:otchet-1"), 100000 KZT) { origin case_input; }
        assert "t13e-a4": otchet_kalkulyatsiya_spo(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13e-a5": otchet_fotografii_obekta(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13e-a6": otchet_iskhodnye_dannye(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
    }
    evaluate truth(otchet_soderzhit_stoimosti_i_obemy(entity_ref("urn:case:vred:otchet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;

    evaluate truth(otchet_soderzhit_prilozheniya(entity_ref("urn:case:vred:otchet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

