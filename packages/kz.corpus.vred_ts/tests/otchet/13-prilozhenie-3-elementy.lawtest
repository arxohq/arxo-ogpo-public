language "law.core" version "0.2";
package kz.corpus.vred_ts version "0.1.0";
namespace "urn:kz:corpus:clir:vred-ts";

// Annex 3 by form ELEMENTS: the title page (eight elements, a seal "if
// present"), the calculation particulars (four), the appendices (three), and
// the final amount without a fractional part (cl. 2).

// The title page is complete, there is no seal, but its absence is
// established and a signature is present — certification under the "if
// present" proviso is satisfied.
test "urn:query:vred-t13-a" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t13a-a0": otchet_nomer(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a1": otchet_data_sostavleniya(entity_ref("urn:case:vred:otchet-1"), @2026-08-30) { origin case_input; }
        assert "t13a-a2-0": otchet_marka(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a2-1": otchet_model(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a2-2": otchet_gos_nomer(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a3": otchet_data_osmotra(entity_ref("urn:case:vred:otchet-1"), @2026-08-30) { origin case_input; }
        assert "t13a-a4": otchet_zayavitel(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a5-0": otchet_strakhovshchik_naimenovanie(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a5-1": otchet_strakhovshchik_bin(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a5-2": otchet_strakhovshchik_rekvizity(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a5-3": otchet_strakhovshchik_adres(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a6": pechat_otsutstvuet(entity_ref("urn:case:vred:otchet-1")) { origin case_input; }
        assert "t13a-a7": otchet_podpis_utverzhdayushchego(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13a-a8": otchet_opisanie_obekta(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
    }
    evaluate truth(otchet_soderzhit_titulnyy_list(entity_ref("urn:case:vred:otchet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(OtchetZaverenPodpisyuBezPechati);
}

