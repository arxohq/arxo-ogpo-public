// Annex 3 cl. 2: the final amount of 1,234,567 tenge without a fractional
// part, spelled out in words — properly expressed.
test "urn:query:vred-t13-g" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t13g-a0": itogovaya_stoimost_v_tenge(o: entity_ref("urn:case:vred:otchet-1"), amount: 1234567 KZT) { origin case_input; }
        assert "t13g-a1": otchet_summa_propisyu(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
    }
    evaluate truth(otchet_soderzhit_itogovuyu_velichinu(entity_ref("urn:case:vred:otchet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

