// Annex 3 cl. 2: an amount of 0.01 tenge — not rounded; an amount of
// 0 tenge — rounded (zero fractional part).
test "urn:query:vred-t13-i" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t13i-a0": itogovaya_stoimost_v_tenge(o: entity_ref("urn:case:vred:otchet-1"), amount: 0.01 KZT) { origin case_input; }
        assert "t13i-a1": otchet_summa_propisyu(entity_ref("urn:case:vred:otchet-1"), "образец") { origin case_input; }
        assert "t13i-a2": itogovaya_stoimost_v_tenge(o: entity_ref("urn:case:vred:otchet-2"), amount: 0 KZT) { origin case_input; }
        assert "t13i-a3": otchet_summa_propisyu(entity_ref("urn:case:vred:otchet-2"), "образец") { origin case_input; }
    }
    evaluate truth(otchet_soderzhit_itogovuyu_velichinu(entity_ref("urn:case:vred:otchet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;

    evaluate truth(otchet_soderzhit_itogovuyu_velichinu(entity_ref("urn:case:vred:otchet-2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
