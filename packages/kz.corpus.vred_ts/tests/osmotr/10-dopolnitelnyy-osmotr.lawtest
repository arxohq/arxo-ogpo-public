// No hidden defects: the inspection under the Rules is derived, the adjustment is not.
test "urn:query:vred-t10-d" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t10d-a1": zayavlenie_o_dopolnitelnom_osmotre(z: entity_ref("urn:case:vred:zayavlenie-2"), r: entity_ref("urn:case:vred:raschet-1")) { origin case_input; }
        assert "t10d-a2": zayavlenie_soderzhit_datu_i_vremya_postupleniya(entity_ref("urn:case:vred:zayavlenie-2")) { origin case_input; }
        assert "t10d-a3": zayavlenie_soderzhit_svedeniya_ob_imushchestve(entity_ref("urn:case:vred:zayavlenie-2")) { origin case_input; }
        assert "t10d-a4": dopolnitelnyy_osmotr_proveden_strakhovshchikom(entity_ref("urn:case:vred:raschet-1")) { origin case_input; }
        assert "t10d-a5": akt_dopolnitelnogo_osmotra_po_raschetu(a: entity_ref("urn:case:vred:akt-2"), r: entity_ref("urn:case:vred:raschet-1")) { origin case_input; }
        assert "t10d-a6": akt_soderzhit_svedeniya_prilozheniya_2(entity_ref("urn:case:vred:akt-2")) { origin case_input; }
    }
    evaluate truth(dopolnitelnyy_osmotr_proveden_po_pravilam(entity_ref("urn:case:vred:raschet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;

    evaluate truth(korrektirovka_pri_skrytykh_defektakh_oformlyaetsya_dopolneniem(entity_ref("urn:case:vred:raschet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
