    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Mixed act: vehicle information by values, the other groups — by the
// earlier presence assertions. Both layers are read together.
test "urn:query:vred-t19-d" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t19d-a0-0": akt_data_provedeniya_osmotra(entity_ref("urn:case:vred:akt-3"), @2026-08-30T10:00:00+05:00) { origin case_input; }
        assert "t19d-a0-1": akt_data_sostavleniya(entity_ref("urn:case:vred:akt-3"), @2026-08-30T11:30:00+05:00) { origin case_input; }
        assert "t19d-a1": akt_sobstvennik(entity_ref("urn:case:vred:akt-3"), "образец") { origin case_input; }
        assert "t19d-a2": akt_soderzhit_svedeniya_o_predstavivshem_lice(entity_ref("urn:case:vred:akt-3")) { origin case_input; }
        assert "t19d-a3": akt_vin(entity_ref("urn:case:vred:akt-3"), "XTA210990Y7654321") { origin case_input; }
        assert "t19d-a4": akt_marka(entity_ref("urn:case:vred:akt-3"), "Lada") { origin case_input; }
        assert "t19d-a5": akt_model(entity_ref("urn:case:vred:akt-3"), "Granta") { origin case_input; }
        assert "t19d-a6": akt_gos_nomer(entity_ref("urn:case:vred:akt-3"), "777ZZZ02") { origin case_input; }
        assert "t19d-a7": akt_god_vypuska(entity_ref("urn:case:vred:akt-3"), 2021) { origin case_input; }
        assert "t19d-a8": akt_probeg(entity_ref("urn:case:vred:akt-3"), 12000 km) { origin case_input; }
        assert "t19d-a9": akt_dopolnitelnoe_oborudovanie(entity_ref("urn:case:vred:akt-3"), "фаркоп") { origin case_input; }
        assert "t19d-a10": akt_snimok_identifikatsionnogo_nomera(entity_ref("urn:case:vred:akt-3"), "vin.jpg") { origin case_input; }
        assert "t19d-a11": odometr_otsutstvuet(entity_ref("urn:case:vred:akt-3")) { origin case_input; }
        assert "t19d-a12": akt_soderzhit_svedeniya_o_povrezhdennykh_elementakh(entity_ref("urn:case:vred:akt-3")) { origin case_input; }
        assert "t19d-a13": akt_fio_osmotrevshego(entity_ref("urn:case:vred:akt-3"), "образец") { origin case_input; }
    }
    evaluate truth(akt_soderzhit_svedeniya_prilozheniya_2(entity_ref("urn:case:vred:akt-3")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(FotoOdometraNeTrebuetsyaBezOdometra);
}

// Inspection is formalised (cl. 2): information on possible defects by value.
test "urn:query:vred-t19-e" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t19e-a0": akt_osmotra_po_raschetu(entity_ref("urn:case:vred:akt-3"), entity_ref("urn:case:vred:raschet-3")) { origin case_input; }
        assert "t19e-a1": akt_soderzhit_svedeniya_prilozheniya_2(entity_ref("urn:case:vred:akt-3")) { origin case_input; }
        assert "t19e-a2": akt_vozmozhnye_defekty(entity_ref("urn:case:vred:akt-3"), "возможен перекос кузова") { origin case_input; }
    }
    evaluate truth(osmotr_oformlen(entity_ref("urn:case:vred:raschet-3")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(OsmotrOformlenAktom);
}
