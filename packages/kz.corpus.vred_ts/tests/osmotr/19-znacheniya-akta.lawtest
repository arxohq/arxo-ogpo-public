        assert "t19b-a0": akt_data_provedeniya_osmotra(entity_ref("urn:case:vred:akt-2"), @2026-08-30T10:00:00+05:00) { origin case_input; }
    }
    evaluate truth(akt_soderzhit_svedeniya_prilozheniya_2(entity_ref("urn:case:vred:akt-2")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
