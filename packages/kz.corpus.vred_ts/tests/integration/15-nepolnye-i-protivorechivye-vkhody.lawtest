// Cl. 10: mileage submitted in a foreign unit (metres instead of
// kilometres) — comparing quantities of different units fails loudly rather
// than computing silently.
test "urn:query:vred-t15-i" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t15i-a0": detal_ts(d: entity_ref("urn:case:vred:detal-1"), v: entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t15i-a1": detal_podlezhit_zamene(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t15i-a2": vladelets_fizicheskoe_litso(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t15i-a3": ne_podlezhit_obyazatelnomu_tekhosmotru(entity_ref("urn:case:vred:ts-1")) { origin case_input; }
        assert "t15i-a4": detal_ne_povrezhdalas_i_ne_remontirovalas(entity_ref("urn:case:vred:detal-1")) { origin case_input; }
        assert "t15i-a5": srednegodovoy_probeg(v: entity_ref("urn:case:vred:ts-1"), distance: 12000 m) { origin case_input; }
    }
    evaluate truth(detal_otsenivaetsya_bez_iznosa(entity_ref("urn:case:vred:detal-1")));
    expect truth_status == NEITHER;
    expect evaluation_status == TYPE_ERROR;
}

// Cl. 9, threshold with tiyn: market value 1,000,000.01 tenge, expenses
// 800,000.01 tenge. 80% of the value is EXACTLY 800,000.008 tenge (§50:
// no rounding is implied), and the expenses exceed it.
test "urn:query:vred-t15-j" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }
        assert "t15j-a0": ozhidaemye_raskhody_na_vosstanovlenie(v: entity_ref("urn:case:vred:ts-1"), amount: 800000.01 KZT) { origin case_input; }
        assert "t15j-a1": rynochnaya_stoimost_na_datu_otcheta(v: entity_ref("urn:case:vred:ts-1"), amount: 1000000.01 KZT) { origin case_input; }
    }
    evaluate truth(vosstanovlenie_ekonomicheski_netselesoobrazno(entity_ref("urn:case:vred:ts-1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
