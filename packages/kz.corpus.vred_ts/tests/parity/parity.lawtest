        assert perechen_defektov_ustanovim(entity_ref("urn:parity:vred:raschet-1")) { id "O07-a4"; origin case_input; }
        assert priznaki_prezhnikh_remontov_ustanovimy(entity_ref("urn:parity:vred:raschet-1")) { id "O07-a5"; origin case_input; }
        assert opredelyaetsya_stoimost_vosstanovitelnogo_remonta(entity_ref("urn:parity:vred:raschet-1")) { id "O07-a6"; origin case_input; }
        assert not dokumenty_o_povrezhdeniyakh_v_dtp_predstavleny(entity_ref("urn:parity:vred:raschet-1")) { id "O07-a7"; origin case_input; }
    }
    evaluate truth(osmotr_vozmozhen(entity_ref("urn:parity:vred:raschet-1")));
    expect truth_status == NEITHER;
    evaluate truth(osmotr_dopustim(entity_ref("urn:parity:vred:raschet-1")));
    expect truth_status == FALSE_ONLY;
}

