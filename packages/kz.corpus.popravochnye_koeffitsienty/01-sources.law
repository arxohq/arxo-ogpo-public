// ИСТОЧНИКИ, РЕДАКЦИИ, ПУБЛИКАЦИИ И ФРАГМЕНТЫ §194.
//
// ТРИ ИСТОЧНИКА, И ЭТО НЕ ИЗБЫТОЧНОСТЬ. Пункт 3-1 статьи 19 Закона РК
// № 446-II делегирует уполномоченному органу и ПОРЯДОК расчёта, и САМИ
// ВЕЛИЧИНЫ, а величины утверждаются ЕЖЕГОДНО отдельным постановлением.
// Поэтому: одни Правила расчёта и по постановлению на каждый закреплённый
// год. Год — не редакция одного акта: постановление 2024 года не изменяет
// постановление 2023-го, оно устанавливает величины на свой год.
//
// ПОЧЕМУ ЗАКРЕПЛЕНЫ ИМЕННО ДВА ГОДА. Пакет обязан отвечать РАЗНЫМИ числами на
// 31.12.2025 и на 01.01.2026; один год сделал бы переход невидимым и позволил
// бы ответить величиной года, о котором не спрашивали. Сцены
// `pk-granitsa-goda-*` стерегут обе стороны рубежа.

language "law.core" version "0.2";
package kz.corpus.popravochnye_koeffitsienty version "0.1.0";
namespace "urn:kz:corpus:clir:popravochnye-koeffitsienty";

// --- Правила расчёта (методика) ---------------------------------------------

source PK_METODIKA {
    kind resolution;
    jurisdiction KZ;
    number "Постановление Правления Агентства Республики Казахстан по регулированию и развитию финансового рынка от 7 июня 2023 года № 46 (зарегистрировано в Министерстве юстиции Республики Казахстан 9 июня 2023 года № 32827)";
    label ru-KZ official "Правила расчета поправочных коэффициентов к коэффициентам по территории регистрации транспортного средства для расчета страховой премии по обязательному страхованию гражданско-правовой ответственности владельцев транспортных средств";
}

edition PK_METODIKA_RU of PK_METODIKA {
    label ru-KZ official "Редакция Правил по состоянию на 12 сентября 2026 года";
    language ru-KZ;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @2023-06-07;
    // Сам акт называет день введения в действие прямо: «вводится в действие
    // с 1 января 2024 года». Догадываться, в отличие от Закона № 446-II и
    // Правил «бонус-малус», не пришлось.
    in_force @2024-01-01;
}

publication PK_METODIKA_TEXT of PK_METODIKA_RU {
    media_type "text/plain; charset=utf-8";
    uri "https://adilet.zan.kz/api/documents/a44f728d-592d-45bf-ad01-fd4a88e951f8";
    retrieved_at @2026-09-12T00:00:00Z;
    content_hash "sha256:338e19e1a8f51f5279d112537b5cd537553d2517b3834f838051b68797ee89e4";
    local_path "sources/popravochnye-koeffitsienty/metodika.ru.txt";
}

// --- Размеры на 2025 год -----------------------------------------------------

source PK_2025 {
    kind resolution;
    jurisdiction KZ;
    number "Постановление Правления Агентства Республики Казахстан по регулированию и развитию финансового рынка от 20 октября 2024 года № 82";
    label ru-KZ official "Об утверждении размеров поправочных коэффициентов, используемых для расчета страховой премии по обязательному страхованию гражданско-правовой ответственности владельцев транспортных средств, на 2025 год";
}

edition PK_2025_RU of PK_2025 {
    label ru-KZ official "Редакция по состоянию на 12 сентября 2026 года";
    language ru-KZ;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @2024-10-20;
    // Окно ЗАКРЫТОЕ, и это не догадка: величины утверждены «на 2025 год», а
    // на 2026-й их заменило постановление № 72. День введения в действие
    // назван самим актом — «вводится в действие с 01.01.2025».
    in_force [@2025-01-01, @2026-01-01);
}

publication PK_2025_TEXT of PK_2025_RU {
    media_type "text/plain; charset=utf-8";
    uri "https://adilet.zan.kz/api/documents/ec10feda-1a93-4425-a625-c898dc92fbe2";
    retrieved_at @2026-09-12T00:00:00Z;
    content_hash "sha256:6c6bc928b551fc23464ba82c09f1deeb0ece1edfb700109d94b36e31cc439232";
    local_path "sources/popravochnye-koeffitsienty/2025.ru.txt";
}

// --- Размеры на 2026 год -----------------------------------------------------

source PK_2026 {
    kind resolution;
    jurisdiction KZ;
    number "Постановление Правления Агентства Республики Казахстан по регулированию и развитию финансового рынка от 12 ноября 2025 года № 72";
    label ru-KZ official "Об утверждении размеров поправочных коэффициентов, используемых для расчета страховой премии по обязательному страхованию гражданско-правовой ответственности владельцев транспортных средств, на 2026 год";
}

edition PK_2026_RU of PK_2026 {
    label ru-KZ official "Редакция по состоянию на 12 сентября 2026 года";
    language ru-KZ;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @2025-11-12;
    // Окно ОТКРЫТОЕ справа: величины утверждены на 2026 год, но акта,
    // заменяющего их с 2027-го, на 12.09.2026 портал не отдаёт. Закрыть окно
    // 1 января 2027 года значило бы объявить отмену, которой источник не
    // знает; правым рубежом станет само постановление на 2027 год, когда оно
    // появится. Следствие названо в README как открытая граница.
    in_force @2026-01-01;
}

publication PK_2026_TEXT of PK_2026_RU {
    media_type "text/plain; charset=utf-8";
    uri "https://adilet.zan.kz/api/documents/d85b3275-8a9d-4364-8de5-6907205a404c";
    retrieved_at @2026-09-12T00:00:00Z;
    content_hash "sha256:ee849252598258cf092c5a1172b993020543f32ec6ec046c63d0c2b147925fe1";
    local_path "sources/popravochnye-koeffitsienty/2026.ru.txt";
}

// --- Фрагменты §194 ----------------------------------------------------------
//
// Фрагменты заведены руками, а не шаблоном `pinning`: единица у двух актов
// размеров — СТРОКА ТАБЛИЦЫ, её локатор из номера пункта не выводится, а у
// методики адресуются пункты с формулой. Перечень — записанное юридическое
// решение о том, что адресуется.

fragment PK_2025_TABLE in PK_2025_RU {
    kind annex;
    locator "table/rates";
    text ru-KZ official """1. Утвердить следующие размеры поправочных коэффициентов, используемых для расчета страховой премии по обязательному страхованию гражданско-правовой ответственности владельцев транспортных средств, на 2025 год:""";
    content_hash "sha256:f4846401357a885babe72fc116fbbe0bfe70d96bc9ad5d84b074d3aca3e80bf9";
}

fragment PK_2026_TABLE in PK_2026_RU {
    kind annex;
    locator "table/rates";
    text ru-KZ official """1. Утвердить следующие размеры поправочных коэффициентов, используемых для расчета страховой премии по обязательному страхованию гражданско-правовой ответственности владельцев транспортных средств, на 2026 год:""";
    content_hash "sha256:79d5ac89298648eeb09bea05bf805a98d0c9a62bf7bdb0e1d9986549414478be";
}
