// БОНУС-МАЛУС — Правила расчета и применения коэффициента по системе
// «бонус-малус» для расчета страховой премии по обязательному страхованию
// гражданско-правовой ответственности владельцев транспортных средств.
// Постановление Правления Национального Банка Республики Казахстан
// от 30 мая 2016 года № 140 (рег. Минюста № 13928).
//
// ЗАЧЕМ ОТДЕЛЬНЫЙ ПАКЕТ. Пункт 10 статьи 19 Закона РК № 446-II не
// устанавливает ни классов, ни правил перехода между ними: он делегирует
// порядок расчёта уполномоченному органу. Пакет `kz.corpus.ogpovts` до
// 12.09.2026 объявлял этот множитель границей и принимал его ФАКТОМ ДЕЛА —
// с записанной причиной «автомат состояний §160 здесь выдуман БЫЛ БЫ, а не
// формализован». Причина была верна ровно в отношении ЗАКОНА и неверна в
// отношении права: делегированный акт существует, у него шестнадцать пунктов
// и приложение-таблица из семнадцати классов. Владельцем нормы становится
// он, а `ogpovts` читает готовый коэффициент через границу пакета.
//
// КАРТА ПАКЕТА
//
//   sources.law                провенанс §194: шестнадцать пунктов + таблица
//   package.law                этот файл: сущности, классы, словарь
//   01-prilozhenie-klassy.law  приложение: коэффициент и переход класса
//   02-svedeniya.law           пункты 2 и 3: что известно и откуда
//   03-nachalnyy-klass.law     пункты 4, 5, 6, 8, 9: первое присвоение
//   04-izmenenie-klassa.law    пункты 3, 7, 10—15: переход и модификаторы
//   05-koeffitsient.law        итоговый коэффициент и пункт 16
//   tests/*.lawtest            сценарии §267

language "law.core" version "0.2";
package kz.corpus.bonus_malus version "0.2.0";
namespace "urn:kz:corpus:clir:bonus-malus";

// Пункт 11 меряет выплату по имуществу в месячных расчетных показателях;
// МРП устанавливает закон о республиканском бюджете на соответствующий год.
import kz.corpus.budget version "0.1.0";

// --- Сущности ---------------------------------------------------------------
//
// ЕДИНИЦА РАСЧЁТА — ЗАКЛЮЧАЕМЫЙ ДОГОВОР, а не человек и не транспортное
// средство. Пункт 2 говорит «коэффициенты устанавливаются и соответствующие
// классы присваиваются страхователю (застрахованному) ПРИ ЗАКЛЮЧЕНИИ
// договора обязательного страхования», и пункт 3 считает случаи и дни «со дня
// предыдущего изменения класса, ВНЕ ЗАВИСИМОСТИ ОТ КОЛИЧЕСТВА ЗАКЛЮЧЕННЫХ
// ДОГОВОРОВ». То есть история принадлежит страхователю, а присвоение —
// моменту заключения; узлом расчёта поэтому взят договор.
//
// Тип назван `Dogovor`, а не `InsuranceContract`: одноимённая сущность
// `kz.corpus.ogpovts` есть договор ПО ЗАКОНУ, со своими сроками, премией и
// прекращением, и отождествлять их значило бы перенести в подзаконный акт
// нормы закона. Связку двух сущностей держит потребитель.
pub entity Dogovor {
    label ru-KZ official "договор обязательного страхования, при заключении которого страхователю (застрахованному) присваивается класс";
}

// --- Классы (приложение к Правилам) -----------------------------------------
//
// Семнадцать членов в ПОРЯДКЕ СТРОК приложения — от самого низкого к самому
// высокому. Порядок есть часть нормы: пункты 10 и 11 говорят «класс на 1
// класс больше», пункты 12 и 13 — «на 1 класс меньше», и без объявленного
// порядка эти слова не имеют значения вовсе.
//
// Имена членов несут ТУ ЖЕ разметку, что источник: «Класс М2» — кириллическая
// М, «Класс 0» — ноль. Латинской M в именах нет; в закреплённых байтах
// портала обе буквы встречаются вперемешку («М2» в шапке строки и «M2» в
// клетках перехода), и переносить эту небрежность вёрстки в тождество
// значения нельзя.
pub enum Klass {
    label ru-KZ official "класс страхователя (застрахованного) по системе «бонус-малус» (приложение к Правилам)";
    KlassM2;
    KlassM1;
    KlassM;
    Klass0;
    Klass1;
    Klass2;
    Klass3;
    Klass4;
    Klass5;
    Klass6;
    Klass7;
    Klass8;
    Klass9;
    Klass10;
    Klass11;
    Klass12;
    Klass13;
}

// --- Месячный расчётный показатель пункта 11 --------------------------------
//
// Пункт 11 меряет выплату по имуществу порогом «двести месячных расчетных
// показателей». Величину МРП устанавливает закон о республиканском бюджете на
// соответствующий год; Правила НЕ называют дня, на который он берётся, и
// подставить сюда день заключения договора либо день страхового случая
// значило бы дописать в подзаконный акт норму, которой в нём нет.
//
// Поэтому применён ТОТ ЖЕ приём, каким читает МРП статья 19 в
// `kz.corpus.ogpovts`: правило на год с окном `effective`, то есть проекция
// as-of §31 выбирает величину по дате, НА КОТОРУЮ спрашивают, а не по дате
// внутри дела. Открытый вопрос владельцу записан в README пакета.
pub relation primenyaemyy_mrp(amount: Money) kind institutional {
    label ru-KZ official "месячный расчётный показатель, применяемый к порогу пункта 11 Правил";
}

@source(BM_POINT_11)
rule PrimenyaemyyMrp2026(amount: Money) strict {
    label ru-KZ official "За расчёты 2026 года применяется месячный расчётный показатель, установленный законом о республиканском бюджете на 2026 – 2028 годы";
    effective [@2026-01-01, @2027-01-01);
    when kz.corpus.budget::mrp(2026, amount);
    then primenyaemyy_mrp(amount);
}
