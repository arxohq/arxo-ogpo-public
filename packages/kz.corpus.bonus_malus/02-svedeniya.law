// ПУНКТЫ 1, 2 И 3 — ЧТО ИЗВЕСТНО, ОТКУДА И ЧТО ЗНАЧИТ НЕИЗВЕСТНОЕ.
//
// Пункт 2 называет основание применения коэффициентов двумя равноправными
// половинами: «информация о страховом случае (страховых случаях), ЛИБО
// ОТСУТСТВИЕ ИНФОРМАЦИИ о страховом случае (страховых случаях), произошедшем
// (произошедших) по вине страхователя (застрахованного) … полученная
// страховщиком из единой базы данных по страхованию … и (или)
// государственных баз данных».
//
// ЭТО НЕ РИТОРИКА, А ТРИ РАЗНЫХ СОСТОЯНИЯ ЗНАНИЯ, и Правила требуют их
// различать:
//
//   1. О деле ничего не сообщено. Основания нет вовсе, и ни один коэффициент
//      не выводится. Пакет отвечает «не установлено» с перечнем недостающих
//      посылок, а НЕ единицей, не нулём и не последним известным классом.
//   2. База данных ПОДТВЕРДИЛА отсутствие информации о страховых случаях.
//      Это положительное сведение, а не молчание; ноль случаев доказан, и
//      столбец «0 страховых случаев» приложения открывается.
//   3. Сведения противоречивы: две разные величины об одном договоре. Ключ
//      `key(dogovor)` отвечает KEY_CONFLICT — громко, а не вторым ответом.
//
// Отдельно стоит ЧЕТВЁРТОЕ состояние, названное последней частью пункта 3:
// информация пунктов 7, 8, 9, 12, 13 и 14 применяется «ПРИ НАЛИЧИИ ДОСТУПА
// единой базы данных по страхованию к данной информации либо возможности её
// получения посредством интеграции с государственными базами данных». То есть
// модификаторы этих пунктов молчат не потому, что событий не было, а потому
// что о них нельзя узнать. Признак доступа заведён отдельным фактом.

language "law.core" version "0.2";
package kz.corpus.bonus_malus version "0.2.0";
namespace "urn:kz:corpus:clir:bonus-malus";

// --- Пункт 2: основание применения коэффициентов ----------------------------

pub enum OsnovanieSvedeniy {
    label ru-KZ official "основание применения коэффициентов: сведения, полученные страховщиком из базы данных (пункт 2)";
    // «информация о страховом случае (страховых случаях)»
    InformatsiyaOSluchayakh;
    // «либо отсутствие информации о страховом случае (страховых случаях)»
    OtsutstvieInformatsiiOSluchayakh;
}

pub relation osnovanie_iz_bazy_dannykh(dogovor: Dogovor, osnovanie: OsnovanieSvedeniy)
    kind empirical {
    key(dogovor);
    label ru-KZ official "страховщик получил из единой базы данных по страхованию (и (или) государственных баз данных) информацию о страховых случаях либо подтверждение её отсутствия (пункт 2)";
}

// Число страховых случаев, произошедших по вине страхователя (застрахованного)
// и по которым осуществлена страховая выплата, со дня предыдущего изменения
// класса (пункт 3, часть вторая).
//
// Факт подаётся ТОЛЬКО вместе с основанием `InformatsiyaOSluchayakh`: число
// без основания есть утверждение о базе данных, которого страховщик не делал.
pub relation sluchaev_v_baze_dannykh(dogovor: Dogovor, chislo: Integer)
    kind empirical {
    key(dogovor);
    label ru-KZ official "число страховых случаев, произошедших по вине страхователя (застрахованного) и по которым осуществлена страховая выплата, со дня предыдущего изменения класса (пункт 3)";
}

// ВЫВОДИМОЕ число случаев — единственный вход остальных пунктов. Две ветви, и
// вторая есть ДОКАЗАННЫЙ ноль, а не умолчание: её открывает положительное
// сведение базы данных, а не отсутствие строки в деле.
pub relation sluchaev_po_vine(dogovor: Dogovor, chislo: Integer) kind institutional {
    key(dogovor);
    label ru-KZ official "установленное число страховых случаев, произошедших по вине страхователя (застрахованного) и по которым осуществлена страховая выплата, со дня предыдущего изменения класса";
}

@source(BM_POINT_2) {
    rule SluchaevPoSvedeniyamBazy(dogovor: Dogovor, chislo: Integer) strict {
        label ru-KZ official "Пункт 2. Основанием для применения страховщиком коэффициентов является информация о страховом случае (страховых случаях), полученная страховщиком из единой базы данных по страхованию и (или) государственных баз данных";
        when osnovanie_iz_bazy_dannykh(dogovor, InformatsiyaOSluchayakh);
        when sluchaev_v_baze_dannykh(dogovor, chislo);
        then sluchaev_po_vine(dogovor, chislo);
    }

    rule SluchaevNetPoPodtverzhdennomuOtsutstviyu(dogovor: Dogovor) strict {
        label ru-KZ official "Пункт 2. Основанием для применения страховщиком коэффициентов является также отсутствие информации о страховом случае (страховых случаях), произошедшем (произошедших) по вине страхователя (застрахованного), полученное страховщиком из базы данных";
        when osnovanie_iz_bazy_dannykh(dogovor, OtsutstvieInformatsiiOSluchayakh);
        then sluchaev_po_vine(dogovor, 0);
    }
}

// --- Пункт 3: дни страхования, лишение права и доступ к сведениям ------------

pub relation dney_strakhovaniya_s_poslednego_izmeneniya(dogovor: Dogovor, dney: Integer)
    kind empirical {
    key(dogovor);
    label ru-KZ official "число календарных дней со дня последнего изменения класса, в течение которых гражданско-правовая ответственность страхователя (застрахованного) по договору обязательного страхования была застрахована, вне зависимости от количества заключенных договоров (пункт 3)";
}

pub relation lishen_prava_upravleniya(dogovor: Dogovor) kind empirical {
    label ru-KZ official "страхователь (застрахованный) лишён права управления транспортными средствами, и срок лишения не истёк (пункт 3, часть пятая)";
}

pub relation dostup_k_svedeniyam_punkta_3(dogovor: Dogovor) kind empirical {
    label ru-KZ official "у единой базы данных по страхованию есть доступ к информации частей четвёртой и пунктов 7, 8, 9, 12, 13, 14 Правил либо возможность её получения посредством интеграции с государственными базами данных (пункт 3, часть шестая)";
}

// Действующий на момент присвоения класс. Пункты 10 и 11 называют его прямо
// («если ДЕЙСТВУЮЩИЙ на момент присвоения класс … является М1 или М2»), а
// приложение строит от него всю строку перехода.
pub relation deystvuyushchiy_klass(dogovor: Dogovor, klass: Klass) kind empirical {
    key(dogovor);
    label ru-KZ official "класс страхователя (застрахованного), действующий на момент присвоения класса по заключаемому договору";
}
