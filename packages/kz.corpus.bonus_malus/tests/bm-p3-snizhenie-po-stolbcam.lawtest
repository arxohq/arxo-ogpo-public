// ПОРОГ СТОЛБЦА «4 И БОЛЕЕ»: четыре и семь случаев дают ОДИН ответ — М2.
// Пара стережёт приведение числа случаев к номеру столбца: потеряйся оно,
// седьмой случай не нашёл бы клетки вовсе.
test "urn:query:bm-p3-chetyre-sluchaya" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "d0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:s:4"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "d1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:s:4"), 4) { origin case_input; }
        assert "d2": deystvuyushchiy_klass(entity_ref("urn:kz:bm:s:4"), Klass3) { origin case_input; }
        assert "d3": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:s:4"), 365) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:s:4"), 3.50));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

