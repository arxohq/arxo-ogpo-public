language "law.core" version "0.2";
package kz.corpus.bonus_malus version "0.2.0";
namespace "urn:kz:corpus:clir:bonus-malus";

// ПУНКТ 3 И ПРИЛОЖЕНИЕ — СНИЖЕНИЕ ПО СТОЛБЦАМ 1, 2, 3 И «4 И БОЛЕЕ».
//
// Ожидаемые классы прочитаны из строки «Класс 3» приложения: один случай — 1
// (1,55), два — М (2,45), три — М1 (3,00), четыре и более — М2 (3,50).
// Доступ к сведениям пункта 3 в деле есть, но модификаторы пунктов 12—14 не
// заявлены, поэтому сдвига нет.

test "urn:query:bm-p3-odin-sluchay" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "a0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:s:1"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "a1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:s:1"), 1) { origin case_input; }
        assert "a2": deystvuyushchiy_klass(entity_ref("urn:kz:bm:s:1"), Klass3) { origin case_input; }
        assert "a3": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:s:1"), 365) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:s:1"), 1.55));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

