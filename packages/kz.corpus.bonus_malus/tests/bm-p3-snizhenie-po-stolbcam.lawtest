// ВЕРХНИЙ ПРЕДЕЛ ПОРЯДКА КЛАССОВ: строка «Класс 13» столбца «0» ведёт снова в
// класс 13 — приложение не знает класса выше. Коэффициент 0,50.
test "urn:query:bm-p3-klass-13-ne-rastet" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "f0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:s:6"), OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
        assert "f1": deystvuyushchiy_klass(entity_ref("urn:kz:bm:s:6"), Klass13) { origin case_input; }
        assert "f2": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:s:6"), 400) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:s:6"), 0.50));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// ПРОТИВОРЕЧИВЫЕ СВЕДЕНИЯ: база данных дала о том же договоре два разных
// числа страховых случаев. Ключ `key(dogovor)` отвечает ОТКАЗОМ СЧИТАТЬ —
// документ становится NON_EXECUTABLE, — а не вторым ответом о премии и не
// выбором одного из двух чисел.
//
// Три состояния знания различены тремя РАЗНЫМИ ответами пакета, и сцены
// стерегут все три: сведений нет вовсе — пустая выборка при исполнимом
// документе (`bm-p2-net-svedeniy`); отсутствие случаев подтверждено базой —
// коэффициент выведен (`bm-p3-rovno-270`); сведения противоречивы — документ
// неисполним (эта сцена).
test "urn:query:bm-p2-protivorechivye-svedeniya" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "g0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:s:7"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "g1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:s:7"), 1) { origin case_input; }
        assert "g2": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:s:7"), 3) { origin case_input; }
        assert "g3": deystvuyushchiy_klass(entity_ref("urn:kz:bm:s:7"), Klass3) { origin case_input; }
        assert "g4": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:s:7"), 365) { origin case_input; }
    }
    evaluate collect k: Decimal where koeffitsient_bonus_malus(entity_ref("urn:kz:bm:s:7"), k);
    expect result_kind == COLLECTION;
    expect evaluation_status == NON_EXECUTABLE;
}
