        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "b0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:s:2"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "b1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:s:2"), 2) { origin case_input; }
        assert "b2": deystvuyushchiy_klass(entity_ref("urn:kz:bm:s:2"), Klass3) { origin case_input; }
        assert "b3": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:s:2"), 365) { origin case_input; }
