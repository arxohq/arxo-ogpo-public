        assert "f5": narusheniy_perechnya_punkta_13(entity_ref("urn:kz:bm:m:6"), 3) { origin case_input; }
        assert "f6": dostup_k_svedeniyam_punkta_3(entity_ref("urn:kz:bm:m:6")) { origin case_input; }
