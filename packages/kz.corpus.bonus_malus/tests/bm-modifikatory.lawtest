// ПУНКТ 16 — собственная оценка рисков страховщика: 0,40 вместо 0,50.
test "urn:query:bm-p16-sobstvennaya-otsenka" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "j0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:m:10"), OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
        assert "j1": deystvuyushchiy_klass(entity_ref("urn:kz:bm:m:10"), Klass13) { origin case_input; }
        assert "j2": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:m:10"), 400) { origin case_input; }
        assert "j3": fizlitso_v_klasse_13_bolee_pyati_let(entity_ref("urn:kz:bm:m:10")) { origin case_input; }
        assert "j4": koeffitsient_sobstvennoy_otsenki(entity_ref("urn:kz:bm:m:10"), 0.40) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:m:10"), 0.40));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// ПУНКТ 16, ВЕРХНЯЯ СТОРОНА ПРЕДЕЛА: 0,60 выше значения приложения для
// 13-класса. Коэффициент не выводится, и §93.3 объявляет нарушение — ответ
// «нарушено» отличается от ответа «не выведено».
test "urn:query:bm-p16-vyshe-predela" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "k0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:m:11"), OtsutstvieInformatsiiOSluchayakh) { origin case_input; }
        assert "k1": deystvuyushchiy_klass(entity_ref("urn:kz:bm:m:11"), Klass13) { origin case_input; }
        assert "k2": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:m:11"), 400) { origin case_input; }
        assert "k3": fizlitso_v_klasse_13_bolee_pyati_let(entity_ref("urn:kz:bm:m:11")) { origin case_input; }
        assert "k4": koeffitsient_sobstvennoy_otsenki(entity_ref("urn:kz:bm:m:11"), 0.60) { origin case_input; }
    }
    evaluate collect k: Decimal where koeffitsient_bonus_malus(entity_ref("urn:kz:bm:m:11"), k);
    expect result_kind == COLLECTION;
    expect collected_count(0);
}
