language "law.core" version "0.2";
package kz.corpus.bonus_malus version "0.2.0";
namespace "urn:kz:corpus:clir:bonus-malus";

// ПУНКТЫ 7, 10, 12, 13, 14, 15 И 16 — МОДИФИКАТОРЫ И ПРЕДЕЛЫ.
//
// ОБЩИЙ ВХОД: действующий класс 3 (место 7 порядка приложения), один
// страховой случай по вине с выплатой, 365 дней страхования, доступ к
// сведениям пункта 3 есть. Строка «Класс 3» столбца «1 страховой случай»
// приложения даёт класс 1 — место 5 порядка, коэффициент 1,55.
//
// КАЖДАЯ СЦЕНА ЗДЕСЬ ЕЩЁ И ПРОБА `not_known` НАД СТРОГИМ ПРОДЮСЕРОМ. Ноль
// сдвига выводится правилом, читающим `not_known(punkt_N_primenyaetsya)`;
// окажись это чтение слепо, дело с ПРИМЕНИМЫМ модификатором получило бы
// одновременно 1 и 0 по ключу `key(dogovor)`, и документ стал бы
// неисполнимым. Сцены с применимым модификатором поэтому обязаны быть
// COMPUTED, а не просто «с верным числом».

// ПУНКТ 10 — упрощённый порядок: класс на 1 больше. Место 5 + 1 = 6, класс 2,
// коэффициент 1,40.
test "urn:query:bm-p10-uproshchennyy-poryadok" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "a0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:m:1"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "a1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:m:1"), 1) { origin case_input; }
        assert "a2": deystvuyushchiy_klass(entity_ref("urn:kz:bm:m:1"), Klass3) { origin case_input; }
        assert "a3": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:m:1"), 365) { origin case_input; }
        assert "a4": uregulirovano_uproshchennym_poryadkom(entity_ref("urn:kz:bm:m:1")) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:m:1"), 1.40));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// ПУНКТ 10 НЕ ПРИМЕНЯЕТСЯ при действующем классе М1: исключение названо самим
// пунктом. Строка «Класс М1» столбца «1» даёт М2 — 3,50.
test "urn:query:bm-p10-isklyuchenie-klass-m1" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "b0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:m:2"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "b1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:m:2"), 1) { origin case_input; }
        assert "b2": deystvuyushchiy_klass(entity_ref("urn:kz:bm:m:2"), KlassM1) { origin case_input; }
        assert "b3": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:m:2"), 365) { origin case_input; }
        assert "b4": uregulirovano_uproshchennym_poryadkom(entity_ref("urn:kz:bm:m:2")) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:m:2"), 3.50));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// ПУНКТ 12 — случай вне территории регистрации: класс на 1 меньше.
// Место 5 − 1 = 4, класс 0, коэффициент 2,30.
test "urn:query:bm-p12-vne-territorii" {
    given {
        context { decision_time @2026-09-15T12:00:00+05:00; knowledge_time @2026-09-15T12:00:00+05:00; legal_time @2026-09-15; timezone "Asia/Almaty"; }
        assert "c0": osnovanie_iz_bazy_dannykh(entity_ref("urn:kz:bm:m:3"), InformatsiyaOSluchayakh) { origin case_input; }
        assert "c1": sluchaev_v_baze_dannykh(entity_ref("urn:kz:bm:m:3"), 1) { origin case_input; }
        assert "c2": deystvuyushchiy_klass(entity_ref("urn:kz:bm:m:3"), Klass3) { origin case_input; }
        assert "c3": dney_strakhovaniya_s_poslednego_izmeneniya(entity_ref("urn:kz:bm:m:3"), 365) { origin case_input; }
        assert "c4": sluchay_vne_territorii_registratsii(entity_ref("urn:kz:bm:m:3")) { origin case_input; }
        assert "c5": dostup_k_svedeniyam_punkta_3(entity_ref("urn:kz:bm:m:3")) { origin case_input; }
    }
    evaluate truth(koeffitsient_bonus_malus(entity_ref("urn:kz:bm:m:3"), 2.30));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

